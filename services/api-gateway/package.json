{
  "name": "@agiworkforce/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for AGI Workforce Mobile Companion",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agiworkforce/apply-patch": "workspace:*",
    "@agiworkforce/data-layer": "workspace:*",
    "@agiworkforce/provider-protocol": "workspace:*",
    "@agiworkforce/provider-runtime": "workspace:*",
    "@agiworkforce/mcp": "workspace:*",
    "@agiworkforce/providers-factory": "workspace:*",
    "@agiworkforce/routing": "workspace:*",
    "@agiworkforce/skills": "workspace:*",
    "@agiworkforce/types": "workspace:*",
    "@clerk/backend": "^3.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "rate-limit-redis": "^4.2.0",
    "ws": "^8.20.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
