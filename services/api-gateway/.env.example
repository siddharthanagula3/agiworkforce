# Neon
NEON_DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/db?sslmode=require

# Clerk
CLERK_SECRET_KEY=sk_test_or_live_key
JWT_SECRET=your-jwt-secret

# Server
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,tauri://localhost

# Signaling
SIGNALING_HTTP_URL=http://localhost:4000

# Rate Limiting — Redis store for multi-instance deployments.
# Set either RATE_LIMIT_REDIS_URL (preferred) or UPSTASH_REDIS_REST_URL.
# Without Redis the limiter uses an in-memory store (per-instance only).
RATE_LIMIT_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
