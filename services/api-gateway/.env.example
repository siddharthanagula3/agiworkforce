# AGI API gateway — environment contract
#
# The service receives configuration from the process environment. Export
# local values from the shell; this runtime does not load .env or .env.local.

# Required at startup.
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-signing-secret

# Required to validate Clerk session tokens from Desktop and Mobile.
CLERK_SECRET_KEY=sk_test_replace_with_matching_clerk_secret_key

# Server and browser/native origins.
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,tauri://localhost,https://tauri.localhost
TRUST_PROXY=false
LOG_LEVEL=debug

# Desktop/Mobile pairing. SIGNALING_INTERNAL_SECRET must exactly match the
# signaling server and is required in production or whenever pairing is enabled.
ENABLE_MOBILE_PAIRING=true
SIGNALING_HTTP_URL=http://localhost:4000
SIGNALING_INTERNAL_SECRET=replace-with-a-shared-random-internal-secret

# Global rate limiting for multi-instance deployments. This must be an
# ioredis-compatible redis:// or rediss:// URL; REST tokens are not consumed.
RATE_LIMIT_REDIS_URL=
# Set to 1 when the platform cannot infer that more than one instance is live.
RATE_LIMIT_MULTI_INSTANCE=0

# Managed provider credentials. Unset providers return unavailable rather than
# silently borrowing a different provider. All values are server-only.
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Optional provider aliases/overrides.
# GEMINI_API_KEY=                    # alias for GOOGLE_API_KEY
# GOOGLE_AI_API_KEY=                 # legacy alias for GOOGLE_API_KEY
# DASHSCOPE_API_KEY=                 # alias for QWEN_API_KEY
# GOOGLE_GENAI_BASE_URL=
# MOONSHOT_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=

# Optional operator controls.
# AGI_MANAGED_COMPUTE_PRIVATE_BETA=0  # emergency kill-switch; unset keeps open
# HOST=0.0.0.0
# SHUTDOWN_GRACE_MS=25000             # must stay below the host kill timeout
# MCP_CONFIG_PATH=
# PROVIDER_HEALTH_URLS={}             # JSON provider-to-health-URL map
# WS_MAX_MESSAGE_SIZE=65536
# WS_AUTH_TIMEOUT_MS=30000
# WS_RATE_LIMIT_MAX_MESSAGES=100
# WS_RATE_LIMIT_WINDOW_MS=60000
