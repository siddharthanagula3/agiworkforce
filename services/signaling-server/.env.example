# AGI signaling server, environment contract
#
# Copy to .env for local development. The service loads .env through dotenv;
# it does not load .env.local.

# Required for persistent pairing sessions.
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for authenticated pairing creation and pair-token HMACs. This must
# exactly match SIGNALING_INTERNAL_SECRET in the web's environment and must be set in
# production.
SIGNALING_INTERNAL_SECRET=replace-with-a-shared-random-internal-secret

# Listener and public URLs.
NODE_ENV=development
SIGNALING_HOST=0.0.0.0
PORT=4000
SIGNALING_WS_PATH=/ws
SIGNALING_HTTP_URL=http://localhost:4000
SIGNALING_WS_URL=ws://localhost:4000/ws
# The one hostname clients and probes use, independent of which deploy target
# is serving. Readiness checks poll this first; see README.md "Canonical endpoint".
SIGNALING_CANONICAL_URL=http://localhost:4000
# Every target behind the canonical name, comma separated. The readiness check
# reports "degraded" when one of them is down and the canonical name is not.
# SIGNALING_FAILOVER_URLS=https://agiworkforce-signaling.fly.dev,https://agiworkforce-signaling.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,tauri://localhost,https://tauri.localhost
TRUST_PROXY=false
# Reverse-proxy hops in front of this service. Only the X-Forwarded-For entry written
# by the outermost trusted hop is accepted as the client IP; the rest is client-supplied.
# TRUSTED_PROXY_HOPS=1
LOG_LEVEL=debug

# Pairing policy. Every registration requires a pair token.
SIGNALING_PAIRING_TTL=300

# Maximum age of a healthy store probe while no pairing or socket is active.
# SIGNALING_DB_IDLE_CHECK_MS=1800000

# Optional admin/metrics endpoints. They remain disabled when this is unset.
ADMIN_API_KEY=

# Where each start writes a redacted snapshot of the deployed configuration.
# Secret values are stored as a truncated digest, never in clear text.
# SIGNALING_CONFIG_BACKUP_DIR=/data/config-backups

# Optional production security headers.
ENABLE_HSTS=false
# HSTS_MAX_AGE=31536000
# HSTS_INCLUDE_SUBDOMAINS=true
# HSTS_PRELOAD=false

# Optional WebSocket abuse-control tuning. WS_CONNECTION_LIMIT and WS_MESSAGE_LIMIT are per
# client IP over WS_RATE_LIMIT_WINDOW_MS and apply before a socket has registered; repeated
# violations blacklist the IP. A registered participant (one pairing role) is limited instead by
# a token bucket of WS_PARTICIPANT_MESSAGE_BURST refilled at WS_PARTICIPANT_MESSAGES_PER_SECOND,
# and is never blacklisted: one relay message per streamed output delta must fit.
# WS_CONNECTION_LIMIT=10
# WS_MESSAGE_LIMIT=100
# WS_RATE_LIMIT_WINDOW_MS=60000
# WS_BLACKLIST_DURATION_MS=300000
# WS_BLACKLIST_THRESHOLD=5
# WS_PARTICIPANT_MESSAGES_PER_SECOND=200
# WS_PARTICIPANT_MESSAGE_BURST=2000
# Server pings every socket at this interval and terminates one that misses two pongs.
# WS_PING_INTERVAL_MS=25000

# Remote Control standing. The relay asks the web app whether each live pairing may continue
# (account, sign-in, plan, workspace policy, switch) at reconnect and at most every
# SIGNALING_STANDING_RECHECK_MS while messages flow. Required in production: without a usable
# https URL every registration is refused. Unset outside production turns the check off.
SIGNALING_STANDING_URL=http://localhost:3000/api/pair/standing
# SIGNALING_STANDING_RECHECK_MS=60000
# How long a pairing may run on its last confirmed standing while the web app cannot answer.
# SIGNALING_STANDING_MAX_STALE_MS=300000
# Absolute pairing lifetime from creation; reconnects never extend a pairing past it. It can only
# shorten the 7 day default: a larger value is ignored and logged once at start.
# SIGNALING_PAIRING_MAX_LIFETIME_MS=604800000

# Optional admin brute-force tuning.
# MAX_AUTH_FAILURES=10
# AUTH_LOCKOUT_DURATION_MS=900000
# AUTH_FAILURE_WINDOW_MS=3600000

# Optional OpenTelemetry export. Unset AGI_OTEL_EXPORTER_ENDPOINT and no span or metric leaves the
# process. AGI_OTEL_HEADERS carries backend auth as comma-separated key=value pairs and is a secret.
# AGI_OTEL_EXPORTER_ENDPOINT=https://otlp.example.com
# AGI_OTEL_SERVICE_NAME=agiworkforce-signaling
# AGI_OTEL_HEADERS=x-api-key=replace-me
# AGI_OTEL_SAMPLE_RATIO=1
# AGI_OTEL_SLOW_SPAN_MS=1000
