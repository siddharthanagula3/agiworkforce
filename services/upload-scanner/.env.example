# AGI upload scanner, environment contract
#
# The bearer token the web sends with every scan. It must equal
# UPLOAD_SCAN_WEBHOOK_TOKEN in the web's environment and be at least 32
# characters; the scanner refuses to start without it.
UPLOAD_SCAN_WEBHOOK_TOKEN=replace-with-the-output-of-openssl-rand-hex-32

# Set only while rotating the token: the retiring value, accepted alongside the
# new one until the web has been redeployed with the new token.
# UPLOAD_SCAN_WEBHOOK_TOKEN_PREVIOUS=

PORT=8080

# Protocol 2, source scans of large chat files (POST /v2/scans). Off while
# UPLOAD_SCAN_SOURCE_HOSTS is unset: the /v2 routes answer 404 and clamd runs
# on clamav/clamd.conf exactly as before. Setting it serves /v2 and starts
# clamd with the large-file limits (CLAMD_SOURCE_SCAN_SETTINGS in
# src/config.ts). A comma list of host names only: the storage endpoint the
# web's presigned GET URLs point at. https, no IP literals, no redirects.
# UPLOAD_SCAN_SOURCE_HOSTS=

# Built values; deployment step 4 (docs/specs/large-file-uploads/plan.md) sets
# the budget and the deadline from measurements on a test app.
# MAX_SOURCE_SCAN_BYTES=545259520
# SCAN_SOURCE_CONCURRENCY=1
# SCAN_QUEUE_MAX=20
# SCAN_SOURCE_BYTES_PER_HOUR=2147483648
# SCAN_BASE_MS=30000
# SCAN_MIN_BYTES_PER_SEC=5242880
