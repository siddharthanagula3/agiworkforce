# AGI upload scanner, environment contract
#
# The bearer token the web sends with every scan. It must equal
# UPLOAD_SCAN_WEBHOOK_TOKEN in the web's environment and be at least 32
# characters; the scanner refuses to start without it.
UPLOAD_SCAN_WEBHOOK_TOKEN=replace-with-the-output-of-openssl-rand-hex-32

# Set only while rotating the token: the retiring value, accepted alongside the
# new one until the web has been redeployed with the new token.
# UPLOAD_SCAN_WEBHOOK_TOKEN_PREVIOUS=

PORT=8080
