# AGI Web — local development
# Copy to .env.local and replace blank credential values. Never commit it.

# Public local endpoints.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true

# Clerk development instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Local or development Neon branch. Set only one URL.
DATABASE_URL=

# Independent development secrets. Use random values; do not copy production.
CSRF_SECRET=
CRON_SECRET=
JWT_SECRET=
DEVICE_TOKEN_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
CUSTOM_CONNECTOR_TOKEN_ENCRYPTION_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY=
LOG_SALT=

# Keep checkout disabled unless local Stripe webhooks and prices are configured.
STRIPE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Optional local Redis for shared rate limiting/session state.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Add only the provider keys needed for the feature under test.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=

# Optional service integrations.
# NEXT_PUBLIC_SANDBOX_ORIGIN=
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Optional locally. Leave unset to exercise the fail-closed 503 response from
# /.well-known/assetlinks.json, or supply a non-production test fingerprint.
# ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS=
