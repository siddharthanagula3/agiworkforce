# AGI Web, local development
# Copy to .env.local and replace blank credential values. Never commit it.

# Public local endpoints.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true
# NEXT_PUBLIC_DISABLE_WAITLIST_AUTOPROMPT=1

# Clerk development instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk rejects session tokens whose azp claim is not listed here; add the
# unpacked extension's chrome-extension://<extension-id> origin to sign in from it.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,chrome-extension://replace_with_extension_id

# Local or development Neon branch. Set only one URL.
DATABASE_URL=

# Independent development secrets. Use random values; do not copy production.
CSRF_SECRET=
CRON_SECRET=
JWT_SECRET=
DEVICE_TOKEN_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
CUSTOM_CONNECTOR_TOKEN_ENCRYPTION_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY=
LOG_SALT=
# Dedicated key for client-IP pseudonymization; falls back to LOG_SALT when unset.
# IP_HASH_PEPPER=

# Keep checkout disabled unless local Stripe webhooks and prices are configured.
STRIPE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC_MONTHLY_USD=
STRIPE_PRICE_BASIC_MONTHLY_INR=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_15X_MONTHLY=

# Native store purchases remain fail-closed until real sandbox products and
# server verification credentials are configured. Never invent product IDs.
MOBILE_IAP_ENABLED=false
MOBILE_IAP_APPLE_PRODUCT_IDS_JSON={}
MOBILE_IAP_GOOGLE_PRODUCT_IDS_JSON={}
# APPLE_APP_STORE_BUNDLE_ID=
# APPLE_APP_STORE_APP_ID=
# APPLE_APP_STORE_ROOT_CA_CERTS_BASE64_JSON=[]
# GOOGLE_PLAY_PACKAGE_NAME=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={}
# GOOGLE_PLAY_PUBSUB_AUDIENCE=
# GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Optional local Redis for shared rate limiting/session state.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Keep local runs off the shared Upstash database. Point AGI_KV_PROVIDER at a
# Redis on this machine, or at memory when nothing needs to be shared between
# processes.
# AGI_KV_PROVIDER=redis
# AGI_KV_REDIS_URL=redis://127.0.0.1:6379

# Add only the provider keys needed for the feature under test.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_WEBHOOK_SECRET= # same value as OpenRouter workspace settings

# Optional identifying contact for local OpenStreetMap geocoding/tile calls.
# AGI_MAP_GEOCODER_CONTACT=http://localhost:3000/contact

# Optional service integrations.
# NEXT_PUBLIC_SANDBOX_ORIGIN=
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_BASE_URL=
# CLOUDFLARE_R2_PRIVATE_BUCKET_NAME= # distinct private generated-media/attachment/knowledge bucket

# Optional locally. Leave unset to exercise the fail-closed 503 response from
# /.well-known/assetlinks.json, or supply a non-production test fingerprint.
# ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS=

# Comma-separated Clerk user ids allowed to reach the platform-operator console
# at /admin and the cross-tenant admin APIs. Unset means nobody: those surfaces
# answer 404 to everyone, including organisation admins and owners.
# AGI_PLATFORM_ADMIN_USER_IDS=
