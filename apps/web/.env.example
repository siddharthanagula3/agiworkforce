# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_HOBBY_MONTHLY=price_...
STRIPE_PRICE_HOBBY_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
# Pro+ tier — $49.99/mo, $499.88/yr. Created live 2026-05-08.
STRIPE_PRICE_PRO_PLUS_MONTHLY=price_1TUWdM0zEfO6BZMhUc2KikXi
STRIPE_PRICE_PRO_PLUS_YEARLY=price_1TUWdN0zEfO6BZMhSMdLudHs
STRIPE_PRICE_MAX_MONTHLY=price_...
STRIPE_PRICE_MAX_YEARLY=price_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-visible API base used by shared web clients. Include /api for the local gateway.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
CRON_SECRET=your-cron-secret

# API gateway
# Server-only proxy target used by app/api/v1/providers/* routes.
API_GATEWAY_URL=http://localhost:3001
# Browser-visible gateway URL used only by direct client integrations.
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3001

# Auth providers
# Keep false unless the matching provider is enabled in Clerk.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false

# Clerk + Neon
AGI_AUTH_PROVIDER=clerk
AGI_DATABASE_PROVIDER=neon
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
AGI_DATABASE_URL=
DATABASE_URL=

# LLM Providers (optional — users bring own keys)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
