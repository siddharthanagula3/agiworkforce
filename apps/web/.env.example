# AGI Web, environment contract
#
# This file documents supported deployment configuration. For local
# development, copy .env.local.example to .env.local.
#
# NEXT_PUBLIC_* values are compiled into browser code and are public. Every
# other value is server-only and must be stored in the deployment secret store.
#
# Every name the shipped source reads must appear here, so a feature cannot ship
# silently disabled behind an undocumented switch. `pnpm check:env-contract`
# enforces that for every literal `process.env.NAME` / `process.env['NAME']` read
# under apps/web. A name reached through a constant or composed at runtime is
# invisible to that scan and is instead pinned by hand in the web contract's
# `documentedKeys` list in scripts/env-doctor.mjs, add yours there too.

# =============================================================================
# Core application, auth, and database (required in production)
# =============================================================================

NEXT_PUBLIC_APP_URL=https://agiworkforce.com
# Browser-visible Express gateway base. Include /api.
NEXT_PUBLIC_API_URL=https://api.agiworkforce.com/api
# Optional demo/incident switch; 1 suppresses the marketing auto-prompt.
# NEXT_PUBLIC_DISABLE_WAITLIST_AUTOPROMPT=1

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_matching_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_replace_with_matching_clerk_secret_key
# Comma-separated browser/native token audiences accepted by API routes and the
# proxy. Clerk rejects any session token whose azp claim is not listed, so the
# browser extension's own origin (chrome-extension://<extension-id>, the id from
# the Chrome Web Store listing) must be here or extension sign-in breaks.
# Unset, this falls back to the origin of NEXT_PUBLIC_APP_URL.
CLERK_AUTHORIZED_PARTIES=https://agiworkforce.com,chrome-extension://replace_with_extension_id

# Optional. apps/web/e2e/qa-capability-harness.ts signInAs('secondary') mints a
# ticket for a second Clerk test-instance identity used in member-level RBAC
# specs. Unset, the harness looks the user up by a fixed test-instance email
# instead; set this only if that lookup account is renamed or removed.
# QA_SECOND_USER_ID=user_replace_with_clerk_test_instance_user_id

# Set one. DATABASE_URL is canonical; AGI_DATABASE_URL is a supported alias.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# AGI_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Local development: run `node scripts/dev-db-ws-proxy.mjs` against a loopback Postgres and set
# AGI_DATABASE_WS_PROXY=127.0.0.1:5433 so the Neon driver reaches it. Never point local dev at production.

# Optional. Which driver the data layer uses to reach that connection string.
# `neon` (the default) speaks the Neon serverless WebSocket protocol and runs on
# edge runtimes. `postgres` speaks plain TCP through node-postgres and reaches
# any Postgres host, self-hosted, RDS, Cloud SQL, or a local server, but not an
# edge runtime. Both enforce the same tenant scope, so moving to another host is
# this value plus credentials.
# AGI_DATABASE_PROVIDER=neon

# =============================================================================
# Security and shared infrastructure
# =============================================================================

# High-entropy signing secrets. CSRF_SECRET_PREV is only for a planned rotation
# window and must be removed after old tokens expire.
CSRF_SECRET=replace-with-at-least-32-random-bytes
# CSRF_SECRET_PREV=
CRON_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-signing-secret

# Device, custom-connector, and GitHub token keys must be exactly 64
# hexadecimal characters (32 bytes). TOTP requires at least 32 characters.
# Use independent random values; never reuse one value across purposes.
DEVICE_TOKEN_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY=
# Required for hosted MCP OAuth grants as well as custom connector tokens.
# All instances sharing connector storage must use the same persistent key ring.
CUSTOM_CONNECTOR_TOKEN_ENCRYPTION_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY=
# High-entropy salt used to pseudonymize identifiers in auth logs.
LOG_SALT=
# Dedicated HMAC key for pseudonymizing client IP addresses (apps/web/lib/server/ip-hash.ts),
# at least 32 characters. Unset, the key is derived from LOG_SALT; with neither set it falls back
# to a per-process random key, so digests stop correlating across instances.
# IP_HASH_PEPPER=

# Key source for shared/lib/security.ts, at least 32 characters. Deliberately
# not NEXT_PUBLIC_ so it stays out of the browser bundle: SecurityManager is a
# server-side tool, and its one client-side caller today falls back instead.
# Server-side use throws in production rather than derive a deterministic key.
ENCRYPTION_KEY=
# Signing key for /api/auth/desktop-token, read only when TOTP_ENCRYPTION_KEY
# is unset. One of the two must be set or the route throws.
# DESKTOP_TOKEN_SECRET=

# Optional external malware scanner for uploads. Unset means structural checks
# only, no antivirus, and no runtime signal says so. Once set it fails closed:
# a scanner that errors or times out rejects the upload.
# UPLOAD_SCAN_WEBHOOK_URL=
# UPLOAD_SCAN_WEBHOOK_TOKEN=

# Distributed rate limiting and E2B session state. Use either naming pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Which key-value backend the KeyValue and RateLimit ports resolve to. Left
# unset, the credentials above select upstash. Set it only to override that:
# upstash, redis (needs AGI_KV_REDIS_URL), memory (one process), none.
# AGI_KV_PROVIDER=upstash
# AGI_KV_REDIS_URL=

# Cross-origin API callers. Production defaults are intentionally narrow.
ALLOWED_ORIGINS=https://agiworkforce.com,https://www.agiworkforce.com,tauri://localhost,https://tauri.localhost

# =============================================================================
# Billing (Stripe keys and every publicly sold individual-plan Price are
# required by production validation; Team remains fail-closed until its Prices
# are provisioned). All keys and Prices must belong to one Stripe account and
# one test/live mode. Price IDs themselves do not encode mode.
# =============================================================================

STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_stripe_publishable_key

# Client/server checkout gates must always match.
STRIPE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false

STRIPE_PRICE_BASIC_MONTHLY_USD=price_...
STRIPE_PRICE_BASIC_MONTHLY_INR=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_MAX_MONTHLY=price_...
STRIPE_PRICE_MAX_15X_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# Enterprise contracts price a committed per-seat quantity against a
# contract-specific Price, so entitlement resolves by Stripe product rather
# than by Price id: any Price whose product is this one is the enterprise
# tier. Leave unset until enterprise billing is provisioned in this Stripe
# account; every enterprise resolution then fails closed to no paid tier.
STRIPE_PRODUCT_ENTERPRISE=prod_...

# Internal recipient for enterprise collection escalations (stage changes and
# the daily repeat once an account reaches 60+ days past due). Distinct from
# AGI_SUPPORT_FALLBACK_EMAIL, which is customer-facing support triage.
BILLING_ALERT_EMAIL=billing-alerts@agiworkforce.com

# Team is sold per seat and is selectable on the pricing page, so a deployment
# that sells Team needs these or every Team checkout fails closed. There is no
# Team yearly INR Price: an INR yearly request falls back to the USD Price.
STRIPE_PRICE_TEAM_MONTHLY_USD=price_...
STRIPE_PRICE_TEAM_MONTHLY_INR=price_...
STRIPE_PRICE_TEAM_YEARLY_USD=price_...
# Optional extra mapping: price_id,tier:price_id,tier
# PRICE_ID_OVERRIDES=

# Native iOS / Android billing is independent of Stripe and stays disabled
# until exact products are registered in both stores. JSON maps logical keys
# from @agiworkforce/types mobile-iap.ts to operator-created product IDs.
MOBILE_IAP_ENABLED=false
MOBILE_IAP_APPLE_PRODUCT_IDS_JSON={}
MOBILE_IAP_GOOGLE_PRODUCT_IDS_JSON={}

# Apple device verification + App Store Server Notifications V2.
APPLE_APP_STORE_BUNDLE_ID=
APPLE_APP_STORE_APP_ID=
# JSON array of Apple root CA certificates encoded as base64 DER.
APPLE_APP_STORE_ROOT_CA_CERTS_BASE64_JSON=[]

# Google Play Developer API verification + authenticated Pub/Sub RTDN push.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={}
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# =============================================================================
# Managed LLM and media providers (optional, server-only)
# =============================================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
# Must match the signing secret configured in OpenRouter workspace settings.
OPENROUTER_WEBHOOK_SECRET=

# Direct routes are supported but MiniMax, Qwen, and Zhipu default through
# OpenRouter while a key is configured.
MINIMAX_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=

# Supported aliases and allowlisted endpoint overrides.
# GOOGLE_AI_API_KEY=
# GEMINI_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GOOGLE_BASE_URL=
# OPENROUTER_BASE_URL=
# MINIMAX_BASE_URL=
# MOONSHOT_BASE_URL=
# ZHIPU_BASE_URL=
# QWEN_BASE_URL=
# DEEPSEEK_BASE_URL=
# XAI_BASE_URL=
# PERPLEXITY_BASE_URL=
# QWEN_FALLBACK_BASE_URL=
# QWEN_FALLBACK_API_KEY=

# Image/video generation.
RUNWAY_API_KEY=

# Optional operator contact included in the identifying OpenStreetMap
# Nominatim/tile User-Agent. Use a monitored email address or HTTPS contact
# page; unset falls back to https://agiworkforce.com.
# AGI_MAP_GEOCODER_CONTACT=https://agiworkforce.com/contact

# Map tiles drawn inside chat map cards, proxied same-origin through
# /api/maps/tile. Unset uses the public OpenStreetMap tiles, which are the
# development default only; production points these at a paid tile endpoint.
# AGI_MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# AGI_MAP_TILE_ATTRIBUTION=Map data from OpenStreetMap contributors
# AGI_MAP_TILE_MAX_ZOOM=19
# A dark basemap for dark mode. Unset, the light tiles are drawn darkened.
# AGI_MAP_TILE_DARK_URL_TEMPLATE=
# AGI_MAP_TILE_DARK_ATTRIBUTION=

# Places search (ratings, hours, addresses) behind the search_places tool.
# Unset, the tool is never offered and a place question is answered without it.
# GOOGLE_PLACES_API_KEY=
# Micro-USD charged to the COGS ledger per places call. Unset uses the
# published Text Search Enterprise rate.
# AGI_PLACES_SEARCH_MICROUSD_PER_CALL=35000

# Providers routed through OpenRouter. Empty means direct-only; unset uses the
# code default (minimax,qwen,zhipu).
# AGI_OPENROUTER_ROUTED_PROVIDERS=minimax,qwen,zhipu

# =============================================================================
# Managed execution, MCP, and connectors (optional)
# =============================================================================

# E2B code execution requires both the explicit cutover and key. Metering is
# inert until the deployment-specific micro-USD/second rate is configured.
AGI_E2B_EXECUTION=0
E2B_API_KEY=
AGI_E2B_COMPUTE_MICROUSD_PER_SECOND=

# JSON maps parsed and validated by the Web MCP/connector boundaries.
WEB_MCP_SERVERS_JSON=
CONNECTOR_MCP_SERVERS_JSON=
# Optional comma-separated skill source layers.
SKILLS_LAYERS=

# Browser-authored skills. Requires migration 0157 (user_skills); leave unset
# outside an environment where that migration has run.
AGI_USER_SKILL_AUTHORING=0

# Hosted OAuth connectors. The descriptor blob is non-secret and reviewable;
# the per-connector secrets stay out of it. Their names are derived from the
# connectorId upper-cased with `-` replaced by `_`, so `google-calendar` needs
# CONNECTOR_OAUTH_GOOGLE_CALENDAR_CLIENT_ID. A partially configured provider is
# treated as absent rather than advertised and broken.
# CONNECTOR_OAUTH_PROVIDERS_JSON={"providers":[{"connectorId":"linear","displayName":"Linear","authorizationUrl":"https://…","tokenUrl":"https://…","mcpUrl":"https://…","transport":"streamable-http","scopes":["read"]}]}
# CONNECTOR_OAUTH_LINEAR_CLIENT_ID=
# CONNECTOR_OAUTH_LINEAR_CLIENT_SECRET=
# Origin the hosted callback lives on. Falls back to NEXT_PUBLIC_APP_URL and is
# never taken from the request Host header.
# Self-service MCP OAuth requires a publicly reachable HTTPS origin serving this
# deployment's client metadata and callback routes. A production callback origin
# does not receive callbacks in a localhost build.
# CONNECTOR_OAUTH_REDIRECT_BASE_URL=

# Incident-response kill-switches. Unset/1 keeps these public-alpha surfaces
# open; 0, false, or off re-gates them.
# AGI_MANAGED_COMPUTE_PRIVATE_BETA=0
# AGI_WEB_MCP_PRIVATE_BETA=0
# Same convention, opposite subject: unset keeps first agentic turns on the
# durable Workflow transport, which survives the browser closing. 0, false, or
# off sends every newly started turn back down the request-scoped inline
# stream. Turns already running keep running either way.
# AGI_DURABLE_INITIAL_TURNS=0
# Same convention: unset keeps context compaction on, so a conversation that
# would drop messages to fit its model's context window gets a cached LLM
# summary of the dropped span instead. 0, false, or off falls back to the
# mechanical trim (a marker message, no summary) for every request.
# AGI_CONTEXT_COMPACTION_ENABLED=0

# Set only when this deployment's direct account with the named provider is
# covered by a zero-data-retention agreement, so a workspace requiring ZDR
# routing may still use that provider's default route instead of falling
# back to OpenRouter with data_collection: deny.
# AGI_OPENAI_ZDR_AGREEMENT=1
# AGI_ANTHROPIC_ZDR_AGREEMENT=1

# GitHub App connector. Leave the complete group unset to disable it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_LOGIN=
# Optional server token used only to avoid unauthenticated release API limits.
GITHUB_TOKEN=

# =============================================================================
# Transactional email and support handoff (optional)
# =============================================================================

# One Resend key serves both channels below. Absent means nothing is sent and
# the product says so rather than reporting a delivery that never happened.
RESEND_API_KEY=
# Sender for scheduled-task notification email. Both this and RESEND_API_KEY
# are required or notification email stays off.
AGI_NOTIFICATIONS_FROM_EMAIL=

# Live human handoff is impossible until this is explicitly truthy, so a
# deployment that has never configured support can never claim a human.
# AGI_SUPPORT_LIVE_HANDOFF_ENABLED=0
# Where escalations are mailed. Must be a monitored mailbox, and the sender
# must be on a Resend-verified domain or every send is rejected.
# AGI_SUPPORT_FALLBACK_EMAIL=support@agiworkforce.com
# AGI_SUPPORT_FROM_EMAIL=support@agiworkforce.com
# Where the health probe pages a human. Email alone waits for someone to read
# it; a probe firing at 06:15 needs to wake somebody. Unset means alerts reach
# an inbox and nothing else, and the probe logs that it did.
# PAGER_WEBHOOK_URL=https://events.pagerduty.com/v2/enqueue
# The reply promise shown to the user. Configurable so a deployment tells the
# truth about its own staffing instead of inheriting a promise.
# AGI_SUPPORT_EXPECTED_REPLY_COPY=within one business day
# Out-of-range values are clamped, not rejected: a fat-fingered timeout must
# not take support down.
# AGI_SUPPORT_AGENT_HEARTBEAT_TTL_SECONDS=90
# AGI_SUPPORT_HANDOFF_WAIT_TIMEOUT_SECONDS=120
# AGI_SUPPORT_HANDOFF_IDLE_TIMEOUT_SECONDS=900
# AGI_SUPPORT_HANDOFF_POLL_INTERVAL_MS=3000
# AGI_SUPPORT_HANDOFF_RETENTION_DAYS=90
# The support widget renders only when this is exactly 1. It defaults off
# because the endpoints it calls are not all built yet.
# NEXT_PUBLIC_SUPPORT_WIDGET_ENABLED=1

# =============================================================================
# Storage, sandbox, and product assets (optional)
# =============================================================================

# Object storage speaks the S3 protocol, so any S3-compatible host serves it:
# set the endpoint and the app reaches Cloudflare R2, Amazon S3, Backblaze B2 or
# a local MinIO with no code change. AGI_STORAGE_PROVIDER accepts s3 or memory,
# and is inferred as s3 whenever an endpoint and both keys are present.
# Force path-style addressing for a host without wildcard DNS for bucket
# subdomains, which is the usual MinIO setup.
# AGI_STORAGE_PROVIDER=
# AGI_STORAGE_ENDPOINT=
# AGI_STORAGE_REGION=
# AGI_STORAGE_ACCESS_KEY_ID=
# AGI_STORAGE_SECRET_ACCESS_KEY=
# AGI_STORAGE_FORCE_PATH_STYLE=
# Public bucket for avatars and legacy public-object reads during migration.
# New generated media and private uploads must never use this bucket.
# AGI_STORAGE_BUCKET=
# AGI_STORAGE_PUBLIC_BASE_URL=
# Separate bucket for every newly generated image/video/file, chat attachment,
# and project-knowledge source. Keep public bucket access disabled and never
# reuse the public bucket name: bytes leave this bucket only through
# authenticated, owner/workspace-scoped routes.
# AGI_STORAGE_PRIVATE_BUCKET=

# The Cloudflare-specific names below are the fallback for each neutral name
# above, so an environment provisioned before the port existed keeps working.
# The endpoint is derived from the account id. Set either set, not both.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=

# Cross-origin artifact renderer (infrastructure/sandbox/index.html). Must be a
# host this app does not serve: a value equal to NEXT_PUBLIC_APP_URL is rejected,
# because the renderer frame carries `allow-same-origin`. Unset falls back to an
# opaque-origin srcDoc frame, which isolates but loses the renderer pipeline.
# Example: https://sandbox.agiworkforce.com
NEXT_PUBLIC_SANDBOX_ORIGIN=

# Desktop release lookup/downloads. Unset falls back to the canonical
# siddharthanagula3/agiworkforce release repository.
DESKTOP_GITHUB_OWNER=
DESKTOP_GITHUB_REPO=
# The Electron cloud shell publishes its v-cloud-desktop-* releases from a
# different repository than the Tauri app.
# DESKTOP_CLOUD_GITHUB_OWNER=
# DESKTOP_CLOUD_GITHUB_REPO=
NEXT_PUBLIC_DOWNLOAD_URL_MAC=
NEXT_PUBLIC_DOWNLOAD_URL_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_URL_LINUX=

# =============================================================================
# Mobile domain association (required for verified Android App Links)
# =============================================================================

# Comma- or newline-separated SHA-256 fingerprints from Google Play Console
# > Setup > App integrity > App signing key certificate. The public
# /.well-known/assetlinks.json route fails closed with 503 when unset/invalid.
ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS=

# =============================================================================
# Observability and browser-visible optional configuration
# =============================================================================

# NEXT_PUBLIC_SENTRY_DSN enables browser + server reporting. SENTRY_DSN is the
# server-only fallback when browser reporting must remain disabled.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_APP_VERSION=
LOG_LEVEL=info

# Local-only React Query devtools.
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false

# Optional operator/build tuning. Defaults live next to each consumer.
# AGI_RATE_LIMIT_CLIENT_IP_SOURCE=x-real-ip
# AGI_RESEARCH_MAX_ITERATIONS=4
# AGI_RESEARCH_MAX_SEARCHES=8
# AGI_RESEARCH_BUDGET_MS=180000
# LLM_TTFT_SLO_TARGET_MS=2500
# LLM_TTFT_SLO_BREACH_MS=5000
# GITHUB_PR_REVIEW_MONTHLY_CAP=100
# ANALYZE=true

# Dangerous recovery/development overrides are intentionally off by default.
# Enable only for a documented incident or loopback-only local workflow.
# AGI_ALLOW_INVALID_ENV=1
# ACCOUNT_STATUS_FAIL_OPEN=1
# CRON_DEV_BYPASS=1
# AGI_RATE_LIMIT_REDIS_OUTAGE_POLICY=fail-open

# Unset (or any value other than "warn") refuses managed execution for a model
# LLMCostCalculator cannot price, throwing UnpricedModelError instead of
# silently billing it at the $1/$4 per-Mtok emergency fallback rate. Set to
# "warn" only while the model catalog is being repaired: managed execution
# proceeds at the fallback rate and a warn-level log plus a counter fire for
# every occurrence.
# AGI_PRICING_UNPRICED_POLICY=warn

# Comma- or newline-separated SHA-256 digests of confirmed illegal media, supplied
# out of band by an industry body (NCMEC, IWF, Tech Coalition). Checked on upload
# before any classifier runs: an exact digest match is a fact, not a probability.
# Unset means the denylist is empty and only the classifier applies, the parser
# logs and fails open on malformed entries rather than rejecting every upload.
MODERATION_HASH_DENYLIST=

# Commit this deployment serves, reported by GET /api/version so a promotion can be
# checked against the SHA CI verified. Optional: Vercel and GitHub Actions inject
# VERCEL_GIT_COMMIT_SHA and GITHUB_SHA respectively, and the route falls back to
# those. Set this only where neither is present, such as a self-hosted build.
# AGI_RELEASE_SHA=

# Comma-separated Clerk user ids allowed to reach the platform-operator console
# at /admin and the cross-tenant admin APIs. Unset means nobody: those surfaces
# answer 404 to everyone, including organisation admins and owners.
# AGI_PLATFORM_ADMIN_USER_IDS=
# Pepper for email pseudonymization (DPDP). Unset = low-entropy, enumerable addresses.
EMAIL_HASH_PEPPER=
# Apple IAP verifier environment: production unless explicitly sandbox.
APPLE_APP_STORE_ENVIRONMENT=

# Mobile-companion pairing broker (/api/pair/initiate).
# SIGNALING_HTTP_URL is the signaling service base URL; SIGNALING_INTERNAL_SECRET is
# the shared bearer it requires on POST /pairings. Both are required or pairing 503s.
SIGNALING_HTTP_URL=
SIGNALING_INTERNAL_SECRET=

# Cross-origin renderer for MCP app cards. Must be an origin distinct from the app
# origin so a tool result cannot script the page that embeds it.
NEXT_PUBLIC_MCP_APP_SANDBOX_ORIGIN=

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
# SUBJECT is the mailto: or https: contact the push service requires.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Composer input implementation. Set to "editor" to render the rich TipTap
# composer, "textarea" (the default) for the legacy textarea. A `?composer=`
# query param and the `agi.composer-editor` localStorage key both override it,
# in that order, see apps/web/features/chat/lib/composer-editor-gate.ts.
# NEXT_PUBLIC_COMPOSER_EDITOR=textarea

# Build-time default for the in-thread response variants gate: on | off.
# On, regenerate and edit keep the previous answer as a sibling behind the n/total pager.
# Browser overrides for one machine: ?variants=on|off or localStorage key agi.message-variants.
NEXT_PUBLIC_MESSAGE_VARIANTS=off

# Build-time default for the free-lane composer copy: on | off.
# On, the free tier is described as the community-model lane. Turn on only alongside the
# server's AGI_FREE_LANE_MODE, or the copy promises routing the server does not honour.
# Browser overrides for one machine: ?freelane=on|off or localStorage key agi.free-lane-ui.
NEXT_PUBLIC_FREE_LANE_UI=off

# Multiplies every rate-limit ceiling by a positive integer, for test runs that
# drive one account through many specs back to back. Read only outside a
# production runtime; anything else resolves to 1 and logs an error.
# playwright.config.ts sets this for the server it starts, alongside blank
# Redis credentials, so an e2e batch never shares the live production bucket.
AGI_RATE_LIMIT_SCALE=

# Origin the sandbox provider proxy is reachable on from E2B. Falls back to
# NEXT_PUBLIC_APP_URL; set it to a tunnel or preview origin when verifying
# proxied coding harnesses against a server that is not the public app.
# AGI_PROVIDER_PROXY_ORIGIN=

# Route and credential breaker windows and thresholds. The breaker sits between
# the router and dispatch: a route or a managed credential that keeps failing is
# parked for a cooldown, then probed once (half open) before it carries traffic
# again. Defaults are 30 minutes of observed outcomes, a 5 minute window for the
# failure-rate trip, 3 consecutive failures or a 0.5 failure rate over at least
# 5 samples to trip, and a 30 second cooldown doubling to 10 minutes. An
# unparseable value keeps the default rather than disabling the breaker.
# AGI_ROUTE_HEALTH_WINDOW_MS=1800000
# AGI_ROUTE_HEALTH_TRIP_WINDOW_MS=300000
# AGI_ROUTE_BREAKER_CONSECUTIVE_FAILURES=3
# AGI_ROUTE_BREAKER_FAILURE_RATE=0.5
# AGI_ROUTE_BREAKER_MIN_SAMPLES=5
# AGI_ROUTE_BREAKER_COOLDOWN_MS=30000
# AGI_ROUTE_BREAKER_MAX_COOLDOWN_MS=600000

# Observed-health route ranking. Off unless set to 1. On, Auto reorders the
# routes it has ALREADY admitted for the chosen model by what the route health
# store measured, failure rate first and then time to first token, both banded so
# sampling noise cannot churn the order. It never admits a route the static
# policy rejected and never substitutes a different model.
# AGI_ROUTING_OBSERVED_HEALTH=1

# How long a settled tool call is remembered, so a retried step cannot run a
# mutating tool a second time. Read-only calls are never blocked. Default 15
# minutes; an unparseable value keeps the default rather than disabling the
# guard, and an unreachable store runs the tool rather than failing the turn.
# AGI_TOOL_IDEMPOTENCY_WINDOW_MS=900000
