# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Paid-plan checkout gate (early-access). Managed cloud access itself is
# public-alpha-open; this only governs whether the upgrade CTAs hit live
# Stripe checkout or fall back to the waitlist. THESE TWO MUST MATCH:
#   STRIPE_CHECKOUT_ENABLED      - checked server-side in app/api/checkout/route.ts
#   NEXT_PUBLIC_CHECKOUT_ENABLED - checked client-side in app/pricing/page.tsx and
#                                   features/billing/pages/BillingDashboard.tsx
# If they diverge, the CTA and the API will disagree (e.g. CTA opens Stripe
# Checkout but the API 400s it, or the CTA silently routes to the waitlist
# while the API would have allowed it). Set both to the same value.
STRIPE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false
STRIPE_PRICE_BASIC_MONTHLY_USD=price_...
STRIPE_PRICE_BASIC_MONTHLY_INR=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_MAX_MONTHLY=price_...
STRIPE_PRICE_MAX_15X_MONTHLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...

# Mobile IAP receipt verification (apps/web/app/api/mobile/iap/verify/route.ts).
# Missing values fail the route CLOSED (503) rather than accepting purchases
# unverified — see lib/server/iap-verify-apple.ts / iap-verify-google.ts.
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_BUNDLE_ID=
# PEM private key (.p8) from App Store Connect > Users and Access > Keys >
# In-App Purchase. Store with literal \n line breaks, or base64-encoded.
APPLE_APP_STORE_PRIVATE_KEY=
# 'sandbox' routes to api.storekit-sandbox.itunes.apple.com for TestFlight
# builds; unset/anything else uses the production endpoint.
APPLE_APP_STORE_ENVIRONMENT=
# Full service-account JSON (single line) from Google Play Console > Setup >
# API access, with the Android Publisher API enabled for that service account.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-visible API base used by shared web clients. Include /api for the local gateway.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Optional local-only React Query devtools. Keep false for demos.
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false
CRON_SECRET=your-cron-secret

# API gateway
# Server-only proxy target used by app/api/v1/providers/* routes.
API_GATEWAY_URL=http://localhost:3001
# Browser-visible gateway URL used only by direct client integrations.
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3001

# Auth providers
# Keep false unless the matching provider is enabled in Clerk.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false

# Clerk + Neon
AGI_AUTH_PROVIDER=clerk
AGI_DATABASE_PROVIDER=neon
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
AGI_DATABASE_URL=
DATABASE_URL=

# LLM Providers (optional — users bring own keys)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Cloudflare R2 object storage (avatars, chat attachments, project knowledge
# files, AI-generated media). Migrated from Vercel Blob — zero egress fees.
# isMediaStorageConfigured()/isObjectStorageConfigured() fall back to
# best-effort/inline behavior when these are unset, so local dev without R2
# still runs.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Public base URL objects are served from — either the bucket's r2.dev URL or
# a custom domain mapped to the bucket in the Cloudflare dashboard. No
# trailing slash.
CLOUDFLARE_R2_PUBLIC_BASE_URL=
