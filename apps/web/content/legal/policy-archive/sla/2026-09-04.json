    {
      "type": "heading",
      "level": 2,
      "anchor": "response",
      "content": [
        {
          "text": "First response, by plan."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "These are current support commitments, not planned targets. Plan names match the billing catalogue. Plan pricing is on "
        },
        {
          "text": "/pricing",
          "href": "/pricing"
        },
        {
          "text": "; it is not restated here so there is only one source of truth for it. Full detail, including how to reach us, is on "
        },
        {
          "text": "/support",
          "href": "/support"
        },
        {
          "text": "."
        }
      ]
    },
    {
      "type": "rows",
      "caption": "Support response commitments",
      "rows": [
        {
          "label": [
            {
              "text": "Free, Basic, Pro, Max 5x, and Max 20x"
            }
          ],
          "value": [
            {
              "text": "Help centre and email · no response-time commitment"
            }
          ]
        },
        {
          "label": [
            {
              "text": "Team"
            }
          ],
          "value": [
            {
              "text": "Email · first response within 1 business day, Central Time"
            }
          ]
        },
        {
          "label": [
            {
              "text": "Enterprise"
            }
          ],
          "value": [
            {
              "text": "Named contact · first response within 4 business hours (Central Time) for a service-down report, 1 business day otherwise · escalation path · status page"
            }
          ]
        },
        {
          "label": [
            {
              "text": "Premium support add-on"
            }
          ],
          "value": [
            {
              "text": "Faster response and on-call, negotiated as an Enterprise order-form line only"
            }
          ]
        }
