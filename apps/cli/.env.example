# AGI CLI — environment contract
#
# Copy to .env for local development. The CLI reads these from the process
# environment; it does not load .env itself.
#
# Every name apps/cli/src reads must appear here. `pnpm check:env-contract`
# enforces that for every literal `env::var("NAME")` read in the crate. A name
# reached through a constant (`env::var(REGISTRY_URL_ENV)`) is invisible to that
# scan and is instead pinned by hand in the cli contract's `documentedKeys` list
# in scripts/env-doctor.mjs — add yours there too.

# ---------------------------------------------------------------------------
# API hosts (token-bearing — allowlisted)
# ---------------------------------------------------------------------------
# These bases receive the account bearer token on every request, so both are
# checked against the same allowlist before any call is made: the value must
# use https and name agiworkforce.com or a subdomain of it. A value that fails
# the check is not used and the request is skipped — it is never sent to the
# host you named.

# Base for the tier lookup (`/api/me`). Defaults to https://agiworkforce.com.
AGIWORKFORCE_API_BASE=https://agiworkforce.com

# Base for the quota check (`/api/llm/v1/credits/balance`), read only on the
# hobby plan. Defaults to https://api.agiworkforce.com.
AGI_API_URL=https://api.agiworkforce.com

# Base for the device-code login flow. Must include the `/api` suffix. Point it
# at a local `next dev` server to exercise login against a web checkout.
# AGI_AUTH_BASE=http://localhost:3000/api

# Account token for the tier lookup. Checked before the OS credential store
# that `agi login` populates, then before the legacy auth.toml.
# AGIWORKFORCE_JWT=

# ---------------------------------------------------------------------------
# Quota banner
# ---------------------------------------------------------------------------
# The low-quota banner only runs when the plan is explicitly "hobby".
# AGI_PLAN=hobby
# Offline/CI override for the remaining percentage, used when the live fetch is
# unavailable or skipped.
# AGI_QUOTA_REMAINING_PCT=100

# ---------------------------------------------------------------------------
# Session defaults (override config.toml)
# ---------------------------------------------------------------------------
# AGI_TEAM=1
# AGIWORKFORCE_PROVIDER=
# AGIWORKFORCE_MODEL=
# AGIWORKFORCE_DEFAULT_MODEL=
# AGIWORKFORCE_MAX_TOKENS=

# ---------------------------------------------------------------------------
# BYOK provider keys
# ---------------------------------------------------------------------------
# Each key stays on this machine and is sent only to the provider that issued
# it. A provider whose key is unset is simply not offered.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MINIMAX_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# Web search tool
# ---------------------------------------------------------------------------
# SEARCH_API_KEY is the on/off switch — without it web_search reports itself
# unconfigured. The provider-specific keys below only choose which API is
# called; Brave wins when both are set, and SEARCH_API_KEY is used as a Brave
# key when neither is.
# SEARCH_API_KEY=
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# app-server (`agi app-server`)
# ---------------------------------------------------------------------------
# Listen address for the WebSocket transport. Defaults to 127.0.0.1:8788
# because Desktop occupies 8787. A non-loopback address is refused unless
# --allow-public-listen is passed.
# AGI_CLI_SERVER_ADDR=127.0.0.1:8788
# Bearer token for that transport, required unless --auth-token is passed.
# Never printed.
# AGI_APP_SERVER_TOKEN=

# ---------------------------------------------------------------------------
# Plugin registry
# ---------------------------------------------------------------------------
# Base URL for plugin lookups and manifest downloads. Takes precedence over
# `[plugins] registry_url` in ~/.agiworkforce/config.toml. Only https is
# accepted, plus http to a loopback host for a local registry.
# AGI_PLUGIN_REGISTRY_URL=

# ---------------------------------------------------------------------------
# Local behavior toggles
# ---------------------------------------------------------------------------
# Config root. Defaults to ~/.agiworkforce, created owner-only (0700).
# AGIWORKFORCE_HOME=
# Store credentials in the owner-only auth file instead of the OS keyring. Set
# this only in a trusted headless environment.
# AGIWORKFORCE_NO_KEYRING=1
# Force vi keybindings in the REPL, overriding ui.edit_mode.
# AGIWORKFORCE_VI=1
# Fall back to the plain REPL instead of the full-screen TUI.
# AGIWORKFORCE_NO_TUI=1

# ---------------------------------------------------------------------------
# Safety opt-outs — each one removes a protection. Development only.
# ---------------------------------------------------------------------------
# Run tools without the OS sandbox.
# AGIWORKFORCE_NO_SANDBOX=1
# Allow A2A requests to private/link-local addresses, disabling SSRF
# protection including the cloud metadata endpoint.
# AGI_A2A_ALLOW_PRIVATE=1
# Allow PowerShell commands the safety check rejected. Needs safe_mode=false
# as well; either alone still blocks.
# AGI_POWERSHELL_ALLOW_UNSAFE=1
# Allow voice audio to leave the machine for OpenAI cloud transcription.
# AGIWORKFORCE_VOICE_ALLOW_CLOUD=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Both take tracing filter syntax. RUST_LOG wins over AGIWORKFORCE_LOG, and
# either one overrides -v/--verbose and --debug on the command line.
# RUST_LOG=agiworkforce_cli=debug
# AGIWORKFORCE_LOG=agiworkforce_cli=debug
