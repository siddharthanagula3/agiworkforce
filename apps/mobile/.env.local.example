# AGI Mobile, local development
# Copy to .env.local. EXPO_PUBLIC_* values are bundled and therefore public.

APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Use a LAN-reachable host instead of localhost when testing on a physical
# device (for example http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GATEWAY_URL=http://localhost:3001
EXPO_PUBLIC_WS_URL=ws://localhost:4000/ws

# Optional in development: when blank, the app uses its built-in Clerk
# development instance. Set this when your local API validates another instance.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# EXPO_PUBLIC_AGI_VISUAL_QA_DISABLE_BIOMETRIC=1
