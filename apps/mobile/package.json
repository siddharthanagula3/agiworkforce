{
  "name": "@agiworkforce/mobile",
  "version": "1.2.0",
  "private": true,
  "license": "PROPRIETARY",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device:dev": "bash scripts/ios-device-dev.sh",
    "ios:device:dev:no-prebuild": "SKIP_IOS_PREBUILD=1 bash scripts/ios-device-dev.sh",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "check:expo-deps": "node scripts/check-expo-deps.mjs",
    "check:tls-pins": "EXPO_PUBLIC_APP_ENV=production node scripts/check-tls-pins.mjs",
    "release:preflight": "bash scripts/release/preflight.sh",
    "release:asc-probe": "node scripts/release/asc-probe.mjs",
    "release:verify-associations": "node scripts/release/verify-production-associations.mjs",
    "release:verify-privacy-declarations": "node scripts/release/verify-privacy-declarations.mjs",
    "test:release-privacy-declarations": "node --test scripts/release/verify-privacy-declarations.test.mjs",
    "release:verify-store-listings": "node scripts/release/verify-store-listings.mjs",
    "test:release-associations": "node --test scripts/release/verify-production-associations.test.mjs",
    "test:ios-device-dev": "node --test scripts/ios-device-dev.test.mjs",
    "test:release-store-listings": "node --test scripts/release/verify-store-listings.test.mjs",
    "release:ios:beta": "bash scripts/release/ios-beta.sh",
    "release:ios:beta:submit": "bash scripts/release/submit-ios.sh --profile beta",
    "release:ios:prod": "bash scripts/release/ios-prod.sh",
    "release:ios:prod:submit": "bash scripts/release/submit-ios.sh --profile production",
    "release:android:beta": "bash scripts/release/android-beta.sh",
    "release:android:beta:submit": "bash scripts/release/submit-android.sh --profile beta",
    "release:android:prod": "bash scripts/release/android-prod.sh",
    "release:android:prod:submit": "bash scripts/release/submit-android.sh --profile production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --ext .ts,.tsx --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0",
    "test": "pnpm run test:node && jest --runInBand --forceExit",
    "test:node": "node --test scripts/ios-device-dev.test.mjs scripts/release/*.test.mjs",
    "test:local": "jest --runInBand --forceExit",
    "test:handles": "jest --runInBand --detectOpenHandles --openHandlesTimeout=5000",
    "test:e2e:ios:ci": "detox test --configuration ios.sim.release --artifacts-location artifacts/mobile-e2e scripts/screenshots/specs/ci-smoke.spec.ts",
    "screenshots": "tsx scripts/screenshots/pipeline.ts all",
    "screenshots:ios": "tsx scripts/screenshots/pipeline.ts ios",
    "screenshots:android": "tsx scripts/screenshots/pipeline.ts android",
    "screenshots:required": "tsx scripts/screenshots/pipeline.ts iphone-17-pro-max && tsx scripts/screenshots/pipeline.ts ipad-pro-13 && tsx scripts/screenshots/pipeline.ts phone",
    "screenshots:verify": "tsx scripts/screenshots/pipeline.ts iphone-17-pro-max --verify",
    "screenshots:composite": "tsx scripts/screenshots/compositor.ts --recompose-all"
  },
  "dependencies": {
    "@agiworkforce/agent-core": "workspace:*",
    "@agiworkforce/artifacts": "workspace:*",
    "@agiworkforce/client-runtime": "workspace:*",
    "@agiworkforce/cloud-contracts": "workspace:*",
    "@agiworkforce/compliance": "workspace:*",
    "@agiworkforce/design-tokens": "workspace:*",
    "@agiworkforce/i18n": "workspace:*",
    "@agiworkforce/local-llm": "workspace:*",
    "@agiworkforce/provider-runtime": "workspace:*",
    "@agiworkforce/routing": "workspace:*",
    "@agiworkforce/search": "workspace:*",
    "@agiworkforce/sync": "workspace:*",
    "@agiworkforce/trust-boundaries": "workspace:*",
    "@agiworkforce/types": "workspace:*",
    "@agiworkforce/utils": "workspace:*",
    "@clerk/expo": "^4.6.5",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@noble/hashes": "^1.8.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.2.1",
    "@react-navigation/native": "^7.3.18",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.16",
    "expo-background-task": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-calendar": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-iap": "5.3.0",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-speech-recognition": "^56.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.4.2",
    "llama.rn": "^0.10.1",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.6",
    "react": "19.2.6",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.2",
    "react-native-executorch": "^0.8.5",
    "react-native-executorch-expo-resource-fetcher": "^0.8.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-nitro-modules": "0.35.10",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "13.16.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@napi-rs/canvas": "^1.0.8",
    "@react-native/metro-config": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.10",
    "detox": "20.51.4",
    "detox-cli": "20.51.4",
    "expect": "29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "plist": "^3.1.1",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native",
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc",
          "react-native-executorch",
          "react-native-executorch-expo-resource-fetcher",
          "llama.rn"
        ]
      }
    }
  }
}
