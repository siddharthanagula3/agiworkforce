<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AGI (mobile), Apple Privacy Manifest
  ====================================================================

  Canonical source consumed by Xcode at build time:
    apps/mobile/ios/<AppName>/PrivacyInfo.xcprivacy
  That path is generated output, the tracked ios/ tree was deleted
  2026-07-16 and `expo prebuild` recreates it from
  `ios.privacyManifests` in apps/mobile/app.config.js.

  This file is the LOCKED submission copy. app.config.js is the source
  of truth; it regenerates the canonical file from the same
  declarations on every prebuild. Keep both in sync.

  Reason codes are from Apple TN3183 ("Adding required reason API
  entries to your privacy manifest") and the per-category index at
  https://developer.apple.com/documentation/bundleresources/describing-use-of-required-reason-api

  AGI Local Mode collects no personal data by default. Signing in to
  AGI Cloud (public alpha, open to any signed-in user, no invite gate)
  collects email address, optional name, the account identifier, the
  conversation content and attachments the user sends, and a device
  identifier for push delivery, all for app-functionality purposes.
  NSPrivacyTracking is false. AGI does not include the AdSupport /
  IDFA APIs.

  There is deliberately no Health & Fitness entry: the Apple Health
  connector, its entitlement, and its usage description were all
  removed in 93ca123df (2026-07-04). apps/mobile reads no health data
  and links no health framework, so nothing here is under-declared.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!--
          UserDefaults: MMKV + RN AsyncStorage write app-private
          configuration (selected provider, last-used model id,
          consent timestamp). All writes are exclusive to AGI's
          container; no shared-app-group reads or writes.
            CA92.1, app-container-exclusive read/write (MMKV / AsyncStorage).
            C56D.1, UserDefaults access from a bundled SDK (GoogleUtilities /
                     Google Sign-In). Apple pairs C56D.1 with UserDefaults.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>C56D.1</string>
            </array>
        </dict>

        <!--
          SystemBootTime: React Native core + Hermes measure
          on-device elapsed time for JS bridge warm-up timings and
          for SSE stream watchdog timeouts in the cloud-chat client.
          Not transmitted off-device.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>

        <!--
          DiskSpace: Local-mode model download UX (M0-M3 tiers) must
          (a) tell the user how much free space remains before
          download and (b) check there is enough space immediately
          before write. Both reasons are required for the same flow.
            85F4.1, display to user on-device
            E174.1, check before writing to verify enough free space
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>85F4.1</string>
                <string>E174.1</string>
            </array>
        </dict>

        <!--
          FileTimestamp: three distinct use cases.
            C617.1, access timestamps on files inside the app's own
                     container (SQLCipher / MMKV / model cache mtimes
                     used for cache eviction).
            3B52.1, access timestamps on files the user provided to
                     the app (image attachments selected from photo
                     library, document picker results).
            0A2A.1, third-party SDK wrapper (ExpoFileSystem file
                     operations that read file timestamps).
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
                <string>3B52.1</string>
                <string>0A2A.1</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
          Other User Content: signing in to AGI Cloud sends the
          conversation itself. services/streaming.ts posts the full
          message list to the cloud chat endpoint, and the provider
          serving the selected model receives it (see
          agiworkforce.com/subprocessors). Local Mode sends nothing.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
          Photos or Videos: images picked from the photo library or
          shot with the camera are uploaded as chat attachments
          (services/api.ts uploadFile) and as the account avatar.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
          User ID: the signed-in account identifier that every
          authenticated cloud request carries.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>

        <!--
          Device ID: an app-generated random UUID (lib/deviceId.ts,
          kept in the keychain, device-only) plus the push token are
          registered against the account at /api/mobile/push-token so
          notifications reach the right install. Not an advertising
          identifier, AGI links no IDFA and ships no AdSupport.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!--
      Tracking: AGI never tracks across apps or websites. We do not
      link any first-party identifier to data collected from other
      companies' apps, websites, or offline properties for advertising
      or measurement.
    -->
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>
</dict>
</plist>
