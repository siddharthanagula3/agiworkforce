# AGI Mobile — supported Expo environment
#
# This is the build/deployment contract. EAS production and preview builds use
# EAS environment variables because eas.json sets EXPO_NO_DOTENV=1. For local
# development, copy .env.local.example to .env.local.
#
# EXPO_PUBLIC_* values are compiled into the app bundle and are public. Never
# place provider API keys, Clerk secret keys, or database credentials in them.

# development | preview | production
# APP_ENV is consumed by app.config.js; keep it equal to EXPO_PUBLIC_APP_ENV.
APP_ENV=production
EXPO_PUBLIC_APP_ENV=production

# Hosted product/API origins.
EXPO_PUBLIC_API_URL=https://agiworkforce.com
EXPO_PUBLIC_GATEWAY_URL=https://api.agiworkforce.com
EXPO_PUBLIC_WS_URL=wss://signaling.agiworkforce.com

# Must belong to the Clerk instance validated by EXPO_PUBLIC_API_URL.
# Preview/production builds fail when this is absent or is a pk_test_ key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_matching_clerk_publishable_key

# Build-only native switches (optional).
# Force or suppress production iOS entitlements for local/prebuild workflows.
# EXPO_ENABLE_PRODUCTION_IOS_ENTITLEMENTS=1
# EXPO_DISABLE_PRODUCTION_IOS_ENTITLEMENTS=1
# Override the Apple development team used by native module generation.
# AGI_IOS_DEVELOPMENT_TEAM=
# EXPO_IOS_DEVELOPMENT_TEAM=
# Include the Detox Android config plugin.
# EXPO_ENABLE_DETOX=1

# Development-only visual QA escape hatch; ignored outside __DEV__ builds.
# EXPO_PUBLIC_AGI_VISUAL_QA_DISABLE_BIOMETRIC=1
