# AGI Mobile -- Expo public config.
#
# EXPO_PUBLIC_* values are INLINED INTO THE APP BUNDLE at build time. They are
# public client identifiers, not secrets. Never put an API key or a Clerk
# secret key here.
#
# CRITICAL: the Clerk instance below must match the instance that the API in
# EXPO_PUBLIC_API_URL validates against. A test publishable key pointed at the
# production API mints JWTs the server rejects, and every authed request 401s.

# development | preview | production
# preview/production builds are hard-required to use a pk_live_ key.
EXPO_PUBLIC_APP_ENV=development

# Cloud API. Production validates the LIVE Clerk instance
# (clerk.agiworkforce.com), so pointing here requires a pk_live_ key below.
EXPO_PUBLIC_API_URL=https://agiworkforce.com

# Realtime signaling.
EXPO_PUBLIC_WS_URL=wss://signaling.agiworkforce.com

# Optional. Defaults to https://api.agiworkforce.com when unset.
EXPO_PUBLIC_GATEWAY_URL=https://api.agiworkforce.com

# REQUIRED whenever EXPO_PUBLIC_API_URL points at production or preview.
# Copy from Clerk Dashboard -> the instance matching EXPO_PUBLIC_API_URL ->
# Publishable key. Leaving this unset silently falls back to the hardcoded
# development test instance (handy-jawfish-73.clerk.accounts.dev) in
# src/integrations/clerk.ts, which 401s against the production API.
# A session minted by one instance is NOT valid on the other: after changing
# this value you must sign out and sign in again.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_key_for_the_matching_instance

# Local visual-QA escape hatch: set to 1 to skip the biometric gate.
# Honored only in __DEV__ builds. Leave unset otherwise.
# EXPO_PUBLIC_AGI_VISUAL_QA_DISABLE_BIOMETRIC=1
