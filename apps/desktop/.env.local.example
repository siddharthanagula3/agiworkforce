# AGI Desktop — local development
# Copy to .env.local. All values are public because Vite embeds VITE_* values.

# Next.js web app and /api routes.
VITE_API_BASE_URL=http://localhost:3000
VITE_WEB_APP_URL=http://localhost:3000

# Express API gateway.
VITE_GATEWAY_BASE_URL=http://localhost:3001

# Optional local overrides.
# VITE_DEV_PORT=1420
# VITE_DESKTOP_UI_DEV_LOCAL=1
# VITE_SENTRY_DSN=
