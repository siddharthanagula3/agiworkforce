<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is deliberately absent. It is a Mac App Store requirement,
         not a Developer ID one, and a sandboxed process can never be granted
         Accessibility, so AXIsProcessTrusted() would always return false and
         every UI-automation surface would be dead in the signed build only.
         The native messaging host also installs its manifest outside the
         container. Keep the hardened runtime; do not reintroduce the sandbox. -->

    <!-- Network Access -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Camera Access -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- Microphone Access -->
    <key>com.apple.security.device.microphone</key>
    <true/>

    <!-- Audio Input -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Apple Events (for automation) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Hardened Runtime Options for Developer ID distribution -->
    <!-- allow-jit is required for WKWebView JavaScript JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- allow-unsigned-executable-memory, disable-library-validation, and
         allow-dyld-environment-variables have been removed: they disable W^X
         memory protection, allow unsigned dylib injection, and enable DYLD_INSERT_LIBRARIES
         attacks respectively. None are required for normal app operation. -->
</dict>
</plist>
