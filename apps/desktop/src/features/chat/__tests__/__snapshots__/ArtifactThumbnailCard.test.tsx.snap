// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ArtifactThumbnailRow > matches snapshot for a single code artifact 1`] = `
<div
  aria-label="Generated artifacts"
  class="flex flex-wrap gap-2 mt-3"
  data-testid="artifact-thumbnail-row"
  role="list"
>
  <div
    role="listitem"
  >
    <button
      aria-label="Open artifact: Snapshot Test"
      class="group flex flex-col overflow-hidden rounded-lg border border-border/40 bg-muted/30 hover:bg-muted/60 transition-colors text-left w-[80px] shrink-0"
      data-testid="artifact-thumbnail-card"
      type="button"
    >
      <div
        class="relative h-[60px] w-full overflow-hidden bg-muted/50"
      >
        <pre
          class="pointer-events-none h-full w-full overflow-hidden px-1.5 py-1 text-[7px] leading-tight font-mono text-muted-foreground/80 whitespace-pre-wrap"
        >
          console.log("hello")
        </pre>
        <div
          class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-colors"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-chevron-right h-4 w-4 text-white opacity-0 group-hover:opacity-100 transition-opacity"
            fill="none"
            height="24"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="m9 18 6-6-6-6"
            />
          </svg>
        </div>
      </div>
      <div
        class="flex flex-col gap-0.5 px-1.5 py-1"
      >
        <span
          class="block max-w-full truncate text-[9px] font-medium text-foreground leading-tight"
        >
          Snapshot Test
        </span>
        <span
          class="inline-block w-fit rounded px-1 py-0.5 text-[8px] font-semibold uppercase leading-tight tracking-wide bg-amber-500/15 text-amber-400"
        >
          Code
        </span>
      </div>
    </button>
  </div>
</div>
`;
