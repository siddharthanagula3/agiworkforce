            d="m6 6 12 12"
          />
        </svg>
      </button>
    </div>
  </div>
  <div
    class="flex-1 flex items-center justify-center p-8 text-center"
  >
    <div
      class="max-w-[240px]"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-code-xml h-12 w-12 mx-auto mb-4 text-zinc-300 dark:text-zinc-700"
