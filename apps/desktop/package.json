{
  "name": "@agiworkforce/desktop",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:vite": "vite",
    "build": "pnpm run build:release",
    "build:native-host": "node scripts/build-native-messaging-host.mjs",
    "build:local": "pnpm run build:native-host && vite build && tauri build --no-sign",
    "build:release": "pnpm run build:native-host && vite build && tauri build",
    "build:web": "tsc && vite build",
    "build:cloud": "VITE_BUILD_TARGET=web vite build",
    "build:electron": "VITE_BUILD_TARGET=electron vite build && node electron/build-main.mjs",
    "dev:electron": "pnpm run build:electron && electron .",
    "dist:electron": "pnpm run build:electron && electron-builder --config electron-builder.yml",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext ts,tsx --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm run test:e2e:build && wdio run wdio.conf.ts",
    "test:e2e:build": "node --test wdio/tauri-config.test.mjs && VITE_WDIO_E2E=1 pnpm exec vite build && node wdio/verify-bundle.mjs && cd src-tauri && TAURI_CONFIG=\"$(node ../wdio/tauri-config.mjs)\" cargo build --features tauri/custom-protocol",
    "test:e2e:only": "wdio run wdio.conf.ts",
    "check:release-binary": "node wdio/check-release-binary.mjs",
    "check:no-devtools": "node scripts/check-no-devtools.mjs",
    "verify:updater-key": "node scripts/verify-updater-key.mjs",
    "test:e2e:dom": "playwright test",
    "test:e2e:dom:ui": "playwright test --ui",
    "test:smoke": "playwright test smoke.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --ext ts,tsx --fix --cache --cache-strategy content --cache-location .cache/eslint"
  },
  "dependencies": {
    "@agiworkforce/apply-patch": "workspace:*",
    "@agiworkforce/artifacts": "workspace:*",
    "@agiworkforce/client-runtime": "workspace:*",
    "@agiworkforce/cloud-contracts": "workspace:*",
    "@agiworkforce/design-tokens": "workspace:*",
    "@agiworkforce/desktop-command-client": "workspace:*",
    "@agiworkforce/i18n": "workspace:*",
    "@agiworkforce/mcp": "workspace:*",
    "@agiworkforce/routing": "workspace:*",
    "@agiworkforce/skills": "workspace:*",
    "@agiworkforce/sync": "workspace:*",
    "@agiworkforce/trust-boundaries": "workspace:*",
    "@agiworkforce/types": "workspace:*",
    "@agiworkforce/ui": "workspace:*",
    "@agiworkforce/unified-chat": "workspace:*",
    "@agiworkforce/utils": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/react": "^10.73.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-stronghold": "^2.3.2",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "immer": "^11.1.18",
    "katex": "^0.16.47",
    "lucide-react": "^1.41.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-window": "^2.3.1",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@agiworkforce/model-registry": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@wdio/cli": "^9.31.6",
    "@wdio/globals": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.6",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "better-sqlite3": "^12.11.1",
    "electron": "^43.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "20.0.3",
    "msw": "^2.15.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
