# AGI Desktop — supported Vite environment
#
# This is the complete renderer/build contract. For local development, copy
# .env.local.example to .env.local instead of copying this production-oriented
# reference.
#
# Every VITE_* value is compiled into the renderer and is public. Never place
# provider keys, database URLs, signing keys, or other secrets in this file.

# Hosted Next.js app and its /api routes.
VITE_API_BASE_URL=https://agiworkforce.com
VITE_WEB_APP_URL=https://agiworkforce.com

# Express API gateway. Gateway-only routes such as /api/pair live here.
VITE_GATEWAY_BASE_URL=https://api.agiworkforce.com

# Optional observability. An empty Sentry DSN disables reporting.
VITE_SENTRY_DSN=
# Normally supplied by release automation/package metadata.
VITE_APP_VERSION=
# Defaults to https://status.agiworkforce.com/status.json.
VITE_STATUS_URL=

# Build-only switches.
# Set to web only when producing the browser build embedded by apps/web.
# VITE_BUILD_TARGET=web
# Override the Vite/Tauri development port (default: 1420).
# VITE_DEV_PORT=1420

# Development-only renderer overrides. Never set these in production.
# Allow the browser-only dev shell to expose Local-mode UI.
# VITE_DESKTOP_UI_DEV_LOCAL=1
# Inject a fake account for subscription-gated UI checks.
# VITE_DEV_ACCOUNT_EMAIL=dev@example.com
# VITE_DEV_ACCOUNT_NAME=Dev User
# VITE_DEV_ACCOUNT_PLAN=pro

# Native in-app sign-in (Clerk Frontend API). Publishable keys are public by
# design. Without it, desktop falls back to browser device authorization.
VITE_CLERK_PUBLISHABLE_KEY=
