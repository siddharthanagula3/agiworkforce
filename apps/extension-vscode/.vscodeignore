# Source files (compiled to out/)
src/**

# Config / build files
.vscode/**
.vscode-test/**
esbuild.js
tsconfig.json
tsconfig.*.json
.tsbuildinfo
.eslintrc*
eslint.config*
.editorconfig
.gitignore
.gitattributes
vitest.config.ts
scripts/**

# Node modules (esbuild bundles dependencies into out/extension.js)
node_modules/**

# Production output allowlist. The package wrapper and verifier enforce the same
# four-file contract; all other compiled output is development/test residue.
out/**
!out/extension.js
!out/webview/render.js
!out/codicons/codicon.css
!out/codicons/codicon.ttf

# Test output
coverage/**
*.test.ts
*.spec.ts

# Misc dev artifacts
**/*.map
**/*.log
*.tmp
.DS_Store
Thumbs.db
.cache/**
.turbo/**

# pnpm / npm lockfiles (not needed in VSIX)
pnpm-lock.yaml
package-lock.json
yarn.lock

# Docs (not needed in VSIX)
COMPETITIVE_VSCODE_RESEARCH.md
competitive-research.md
PLAN.md
TODO.md
CHANGELOG.md
CLAUDE.md
AGENTS.md
MARKETPLACE_PUBLISH_RUNBOOK.md
docs/**

# Test-only root configuration
vitest.*.config.ts

# CI/CD
.github/**
