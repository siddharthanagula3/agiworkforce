    "configuration": {
      "title": "AGI Code",
      "properties": {
        "agiWorkforce.apiEndpoint": {
          "type": "string",
          "default": "https://agiworkforce.com/api/llm/v1",
          "description": "AGI API endpoint base URL"
        },
        "agiWorkforce.model": {
          "type": "string",
          "default": "auto",
          "description": "Default LLM model. Run 'AGI Code: Select Model' (cmd+shift+m) to pick from currently available providers."
        },
        "agiWorkforce.cliPath": {
          "type": "string",
          "default": "agi",
          "scope": "machine",
          "description": "Path to the AGI CLI executable that owns workspace-scoped local developer sessions."
        },
        "agiWorkforce.composer.followUpBehavior": {
          "type": "string",
          "enum": [
            "queue",
            "steer"
          ],
          "enumDescriptions": [
            "Queue messages sent during an active turn and start them in order after that turn finishes.",
            "Steer the active turn with messages sent while it is running; conflicts visibly fall back to the next-turn queue."
          ],
          "default": "queue",
          "description": "Default behavior when sending from the composer during an active developer turn. The key that sends with the other behavior once is Cmd/Ctrl+Enter, or Cmd/Ctrl+Shift+Enter when Cmd/Ctrl+Enter is the send key."
        },
        "agiWorkforce.composer.enterBehavior": {
          "type": "string",
          "enum": [
            "enter",
            "modifierIfMultiline",
            "modifier"
          ],
          "enumDescriptions": [
            "Enter sends. Shift+Enter adds a line.",
            "Enter sends a one-line prompt. Once the prompt has several lines, Enter adds a line and Cmd/Ctrl+Enter sends.",
            "Cmd/Ctrl+Enter sends. Enter adds a line."
          ],
          "default": "enter",
          "description": "Which key sends a prompt from the composer."
        },
        "agiWorkforce.contextLines": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 500,
          "description": "Number of surrounding lines to include as context"
        },
        "agiWorkforce.editorContext.autoAttach": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Attach the active editor file, the current selection and that file's problems to each chat turn. Every attachment shows as a removable chip in the composer before you send."
        },
        "agiWorkforce.respectGitIgnore": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Leave files that git ignores out of `@` file search, and send only the path of an ignored file that is open in the editor. Takes effect while `#search.useIgnoreFiles#` is also on."
        },
        "agiWorkforce.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Send product usage events, such as stopping a response or accepting a suggested edit, to your AGI account when its [product analytics choice](https://agiworkforce.com/settings/privacy?from=vscode-extension) allows them. Also subject to VS Code's telemetry setting."
        },
        "agiWorkforce.memory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include your saved workspace memory facts with chat turns. Turn this off to stop sending them without deleting them; the Memory view keeps showing what is stored."
        },
        "agiWorkforce.hoverEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show AGI Code quick actions on hover over identifiers"
        },
        "agiWorkforce.codeLensEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show AGI Code action lenses above every function and class. Off by default: the lenses render on every declaration in every open file, which competes with the editor's own lenses (references, implementations, test status). The same actions are always available from the right-click menu and the sidebar."
        },
        "agiWorkforce.autoApplyFixes": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply AI-suggested fixes without showing a diff"
        },
        "agiWorkforce.inlineCompletions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Send surrounding code to AGI Cloud for ghost-text inline completions. Sensitive files are excluded. Requires browser sign-in or an AGI API key."
        },
        "agiWorkforce.inlineCompletions.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 2000,
          "description": "Debounce delay in milliseconds before requesting inline completions (default: 300ms)"
        },
        "agiWorkforce.inlineCompletions.maxLength": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Maximum character length for inline completion suggestions (default: 500)"
        },
        "agiWorkforce.agent.planMode": {
          "type": "boolean",
          "default": false,
          "deprecationMessage": "Use AGI Code: Open Settings and choose Agent mode → Plan instead.",
          "description": "Deprecated, use agiWorkforce.agent.mode instead. When true, maps to agent.mode = 'plan'."
        },
        "agiWorkforce.agent.mode": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "plan",
            "bypass"
          ],
          "enumDescriptions": [
            "Ask before edits and commands.",
            "Read and edit files without asking; running commands and changing git hooks or MCP settings still ask first.",
            "Propose a plan before making edits.",
            "Skip approval prompts for workspace/additional-directory, terminal, network-capable command, and configured MCP tool access. Selecting this requires a modal risk confirmation."
          ],
          "default": "auto",
          "scope": "machine",
          "description": "Default agent mode for new conversations. 'ask' confirms writes and commands, 'auto' reads and edits files without asking while running commands and changing git hooks or MCP settings still ask first, 'plan' proposes a plan before any edits, and 'bypass' skips all approval prompts only after explicit risk confirmation. A repository cannot set this: it is machine-scoped, and Bypass Permissions is confirmed per workspace."
        },
        "agiWorkforce.agent.effort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium",
          "scope": "machine",
          "description": "Reasoning effort for providers that support it (Anthropic, OpenAI, Google). Ignored when provider does not support an explicit effort axis. Machine-scoped so a repository cannot raise it."
        },
        "agiWorkforce.agent.thinking": {
          "type": "boolean",
          "default": false,
          "description": "Enable extended thinking for cloud-backed editor utilities such as Explain, Fix, diagnostics, and inline completion. This setting does not affect local @agi, sidebar, or editor developer sessions, whose reasoning effort is controlled by the Effort setting."
        },
        "agiWorkforce.currentTier": {
          "type": "string",
          "default": "unknown",
          "readOnly": true,
          "description": "Current subscription tier (read-only, populated on activation). Run 'AGI Code: Show Tier Status' to see full usage details or visit agiworkforce.com/pricing to upgrade."
        },
        "agiWorkforce.activateOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Start AGI Code background work (device heartbeat, plan lookup) as soon as the window opens. Off by default, so nothing leaves the machine until you open the AGI view, run an AGI command or reopen an AGI session."
        },
        "agiWorkforce.useTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Launch the AGI CLI in the integrated terminal instead of the native UI when you run AGI Code: Open Chat."
        }
      }
    },
    "keybindings": [
      {
        "command": "agi-workforce.chat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "!terminalFocus && !agi-workforce.hasDiff"
      },
      {
        "command": "agi-workforce.explain",
        "key": "ctrl+shift+alt+e",
        "mac": "cmd+shift+alt+e",
        "when": "editorHasSelection"
      },
      {
        "command": "agi-workforce.agentMode",
        "key": "ctrl+shift+alt+g",
        "mac": "cmd+shift+alt+g"
      },
      {
        "command": "agi-workforce.askAboutCode",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "agi-workforce.explainError",
        "key": "ctrl+shift+alt+x",
        "mac": "cmd+shift+alt+x",
        "when": "editorTextFocus"
      },
      {
        "command": "agi-workforce.runCommand",
        "key": "ctrl+shift+alt+t",
        "mac": "cmd+shift+alt+t"
      },
      {
        "command": "agi-workforce.newConversation",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n"
      },
      {
        "command": "agi-workforce.newConversation",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "agi-workforce.chatFocused"
      },
      {
        "command": "agi-workforce.acceptCurrentDiff",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus && agi-workforce.hasDiff"
      },
      {
        "command": "agi-workforce.rejectCurrentDiff",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && agi-workforce.hasDiff"
      },
      {
        "command": "agi-workforce.acceptDiff",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && agi-workforce.hasDiff"
      },
      {
        "command": "agi-workforce.rejectDiff",
        "key": "escape",
        "when": "editorTextFocus && agi-workforce.hasDiff"
      },
      {
        "command": "agi-workforce.acceptAllDiffsGlobal",
        "key": "ctrl+shift+alt+y",
        "mac": "cmd+shift+alt+y",
        "when": "agi-workforce.hasDiff"
      },
      {
        "command": "agi-workforce.rejectAllDiffsGlobal",
        "key": "ctrl+shift+alt+u",
        "mac": "cmd+shift+alt+u",
        "when": "agi-workforce.hasDiff"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "pnpm run clean && node esbuild.js --production && node scripts/vsce-package.js package --no-dependencies",
    "verify:package": "node scripts/verify-vsix.mjs",
    "lint": "eslint src --ext ts --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0",
    "test": "vitest run",
    "test:webview": "vitest run --config vitest.webview.config.ts",
    "test:integration": "tsc -p tsconfig.test.json --noEmit && node esbuild.js --tests && node esbuild.js && node out/test/runTests.js",
    "test:integration:vsix": "tsc -p tsconfig.test.json --noEmit && node esbuild.js --tests && node out/test/runTests.js",
    "test:integration:package": "pnpm run package && tsc -p tsconfig.test.json --noEmit && node esbuild.js --tests && node out/test/runTests.js --vsix-package",
    "typecheck": "tsc --noEmit",
    "check:refs": "tsc -b tsconfig.build.json",
    "clean": "rimraf out",
    "prebuild": "pnpm run clean && pnpm run typecheck",
    "build": "pnpm run compile",
    "check:vscode-theme-tokens": "node scripts/check-vscode-theme-tokens.mjs"
  },
