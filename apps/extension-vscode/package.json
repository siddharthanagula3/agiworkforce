{
  "name": "agi-workforce",
  "displayName": "AGI Code",
  "description": "Multi-provider AI coding assistant for VS Code",
  "version": "0.0.1",
  "publisher": "agiworkforce",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharthanagula3/agiworkforce"
  },
  "bugs": {
    "url": "https://github.com/siddharthanagula3/agiworkforce/issues"
  },
  "homepage": "https://agiworkforce.com",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0f0f0f",
    "theme": "dark"
  },
  "qna": "marketplace",
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "llm",
    "chat",
    "copilot",
    "assistant",
    "coding",
    "agent",
    "gpt",
    "claude",
    "gemini"
  ],
  "activationEvents": [
    "onChatParticipant:agiworkforce.agi",
    "onView:agi-workforce.sidebar",
    "onWebviewPanel:agi-workforce.chatPanel",
    "onUri",
    "workspaceContains:.agiworkforce/instructions.md",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "API endpoint, CLI path, model boundary, auto-apply, startup connection, and tier settings cannot be overridden by workspace settings in untrusted workspaces. Agent mode file writes are disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "agiWorkforce.apiEndpoint",
        "agiWorkforce.cliPath",
        "agiWorkforce.model",
        "agiWorkforce.autoApplyFixes",
        "agiWorkforce.memory.enabled",
        "agiWorkforce.telemetryEnabled",
        "agiWorkforce.activateOnStartup",
        "agiWorkforce.useTerminal"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "AGI Code runs the AGI CLI against a checkout on disk, so agent mode, git, terminal commands and local developer sessions need a real filesystem. Open the repository locally, or through a remote, dev container or WSL window."
    }
  },
