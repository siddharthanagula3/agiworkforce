        "id": "agiWorkforce.gettingStarted",
        "title": "Get started with AGI Code",
        "description": "Understand workspace scope, task handoffs, review, autonomy, and trust boundaries before your first developer session.",
        "steps": [
          {
            "id": "installCli",
            "title": "Install the AGI CLI",
            "description": "Chat and developer sessions run on the AGI CLI in this environment. [Install AGI CLI](command:agi-workforce.installCli)",
            "media": {
              "markdown": "media/walkthrough/00-cli.md"
            },
            "completionEvents": [
              "onCommand:agi-workforce.installCli"
            ]
          },
          {
            "id": "openDeveloperSession",
            "title": "Work in this repository",
            "description": "AGI developer sessions stay scoped to the open workspace and local runtime. [Open AGI Chat](command:agi-workforce.chat)",
            "media": {
              "markdown": "media/walkthrough/01-workspace.md"
            },
            "completionEvents": [
              "onCommand:agi-workforce.chat"
            ]
          },
          {
            "id": "understandTaskHandoff",
            "title": "Follow background work from the IDE",
            "description": "Cloud AGI Work runs started on any device show their state, age and pending approvals in the Cloud Tasks view. [Show Cloud Tasks](command:agi-workforce.showCloudTasks)",
            "media": {
              "markdown": "media/walkthrough/02-tasks.md"
            },
            "completionEvents": [
              "onCommand:agi-workforce.showCloudTasks"
            ]
          },
          {
            "id": "reviewChanges",
            "title": "Turn intent into a reviewed change",
            "description": "Attach workspace files, ask AGI to implement a TODO, and inspect the native diff before accepting changes. [Open AGI Settings](command:agi-workforce.openSettings)",
            "media": {
              "markdown": "media/walkthrough/03-review.md"
            },
            "completionEvents": [
              "onCommand:agi-workforce.openSettings"
            ]
          },
          {
            "id": "reviewTrustBoundary",
            "title": "Set autonomy and verify the boundary",
            "description": "Review generated code and commands. The header names Local, BYOK, or Managed Cloud, and Account & Usage identifies the relevant plan owner. [Review Account & Usage](command:agi-workforce.showAccountUsage)",
            "media": {
              "markdown": "media/walkthrough/04-trust.md"
            },
            "completionEvents": [
              "onCommand:agi-workforce.showAccountUsage"
            ]
          },
          {
            "id": "setUpMemory",
            "title": "Decide what AGI remembers",
            "description": "Memory keeps short facts about you in your AGI Cloud account and sends them with your turns while it is on. [Open Memory](command:agi-workforce.memory)",
            "media": {
              "markdown": "media/walkthrough/05-memory.md"
            },
            "completionEvents": [
              "onCommand:agi-workforce.memory"
            ]
          }
        ]
      }
    ],
    "chatParticipants": [
      {
        "id": "agiworkforce.agi",
        "name": "agi",
        "fullName": "AGI Code",
        "description": "Multi-provider AI coding assistant for VS Code",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain the selected code or current file",
            "sampleRequest": "Explain how this function works and why it is written this way"
          },
          {
            "name": "fix",
            "description": "Find and fix bugs or issues in the selected code",
            "sampleRequest": "Find and fix any bugs or errors in this code"
          },
          {
            "name": "refactor",
            "description": "Suggest refactoring improvements for the selected code",
            "sampleRequest": "Refactor this code to improve readability and maintainability"
          },
          {
            "name": "tests",
            "description": "Generate unit tests for the selected code",
            "sampleRequest": "Generate comprehensive unit tests covering edge cases and error conditions"
          },
          {
            "name": "docs",
            "description": "Generate documentation comments for the selected code",
            "sampleRequest": "Generate JSDoc documentation comments for this code"
          },
          {
            "name": "model",
            "description": "Switch the active LLM model",
            "sampleRequest": "Switch to a faster model"
          }
        ],
        "disambiguation": [
          {
            "category": "coding",
            "description": "Questions about writing, understanding, debugging, or improving code",
            "examples": [
              "Explain this function to me",
              "Why is this code throwing an error?",
              "How can I optimize this algorithm?",
              "Write unit tests for this class"
