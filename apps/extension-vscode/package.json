{
  "name": "agi-workforce",
  "displayName": "AGI Workforce",
  "description": "Multi-provider AI coding assistant for VS Code",
  "version": "0.3.0",
  "publisher": "agiworkforce",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharthanagula3/agiworkforce"
  },
  "bugs": {
    "url": "https://github.com/siddharthanagula3/agiworkforce/issues"
  },
  "homepage": "https://agiworkforce.com",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0f0f0f",
    "theme": "dark"
  },
  "qna": "marketplace",
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "llm",
    "chat",
    "copilot",
    "assistant",
    "coding",
    "agent",
    "gpt",
    "claude",
    "gemini"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:agiworkforce.agi",
    "onView:agi-workforce.sidebar",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "API endpoint, CLI path, model boundary, auto-apply, telemetry endpoint, and tier settings cannot be overridden by workspace settings in untrusted workspaces. Agent mode file writes are disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "agiWorkforce.apiEndpoint",
        "agiWorkforce.cliPath",
        "agiWorkforce.model",
        "agiWorkforce.autoApplyFixes",
        "agiWorkforce.memory.enabled",
        "agiWorkforce.telemetryEnabled",
        "agiWorkforce.telemetryEndpoint"
      ]
    }
  },
