{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // Include DOM lib here even though VS Code extensions don't run in
    // a DOM context, `packages/contracts/types/src/tauri.ts` references DOM
    // types (PerformanceEntry, Node, DOMRectReadOnly) that TS 6 needs
    // to resolve through the type-source check even when the import is
    // never instantiated.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // Off, as in tsconfig.base.json and the Chrome extension: the shared cloud
    // contracts are Zod schemas typed against `@agiworkforce/types/protocol`,
    // which ts-rs generates from Rust as `field?: T` with no `| undefined`. A
    // consumer that turns this on cannot compile those sources at all, so
    // turning it on here would mean hand-copying the contracts instead.
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "inlineSources": false,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "out", ".vscode-test", "src/__tests__"]
}
