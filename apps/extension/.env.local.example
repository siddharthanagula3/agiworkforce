# AGI Chrome extension, local development
# Copy to .env.local. These are public client/build values, not secrets.

VITE_AGI_WEB_API_BASE_URL=http://localhost:3000

# Use the Clerk development instance paired with the local web app.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_matching_clerk_publishable_key
CLERK_FRONTEND_API=https://replace-with-instance.clerk.accounts.dev
CLERK_SYNC_HOST=http://localhost:3000

# Crash reporting is off in development unless you set a DSN and opt in from
# the options page. Leave unset to develop without a Sentry project.
# VITE_SENTRY_DSN=

# Only required when testing production-style package identity locally.
# CHROME_EXTENSION_PUBLIC_KEY=
