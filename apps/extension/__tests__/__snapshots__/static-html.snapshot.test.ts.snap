// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Chrome extension static HTML snapshots > locks the popup.html structure 1`] = `
"<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AGI</title>
    <!--
      M-08 audit 2026-05-19: inline <style> block extracted to ./popup.css so
      the CSP can drop 'unsafe-inline' from style-src. The CSS is byte-for-byte
      identical to what was in the inline block; only the delivery channel
      changed. Vite copies popup.css into dist/ via the static-copy plugin.
    -->
    <link rel="stylesheet" href="./popup.css" />
  </head>
  <body>
    <div class="header">
      <div class="header-brand">
        <h1>AGI</h1>
        <p>Browser control plane</p>
      </div>
      <!-- Compact status pill replaces the verbose status-card (Claude/Comet parity) -->
      <div class="status-pill" id="statusCard">
        <div class="status-dot" id="statusDot"></div>
        <span class="status-pill-label" id="statusTitle">Connecting…</span>
        <button class="reconnect-btn" id="reconnectBtn" title="Reconnect to desktop app">
          &#8635;
        </button>
      </div>
    </div>

    <div class="content">
      <!-- Quick Actions — icon-first compact grid with hover tooltips (Claude/Comet parity) -->
      <div class="actions">
        <button class="action-btn primary" id="sidePanelBtn" title="Open side-panel chat">
          <span class="btn-icon btn-icon-chat" aria-hidden="true"></span>
          <span class="btn-label">Chat</span>
        </button>
        <button class="action-btn primary" id="captureBtn" title="Capture page screenshot">
          <span class="btn-icon btn-icon-camera" aria-hidden="true"></span>
          <span class="btn-label">Capture</span>
        </button>
        <button class="action-btn" id="refreshBtn" title="Refresh current tab">
          <span class="btn-icon btn-icon-refresh" aria-hidden="true"></span>
          <span class="btn-label">Refresh</span>
        </button>
        <button class="action-btn" id="groupBtn" title="Group tab with similar tabs">
          <span class="btn-icon btn-icon-folder" aria-hidden="true"></span>
          <span class="btn-label">Group</span>
        </button>
      </div>

      <!-- Statistics -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-value" id="tabCount">-</div>
          <div class="stat-label">Tabs</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" id="actionCount">-</div>
          <div class="stat-label">Actions</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" id="sessionTime">-</div>
          <div class="stat-label">Session</div>
        </div>
      </div>

      <div class="divider"></div>

      <!-- In-page panel toggle -->
      <div class="info-section">
        <div class="section-title">In-Page Panel</div>
        <div class="info-item">
          <span class="info-label">Page chat overlay</span>
          <label class="toggle-switch" aria-label="Toggle in-page panel">
            <input type="checkbox" id="inPagePanelToggle" checked />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="divider"></div>

      <!-- Site Allowlist — manage which origins can drive automation.
           Fixes the misleading background.ts error string "Add it from the
           extension popup" that referred to a UI that did not exist. -->
      <div class="info-section allowlist-section">
        <div class="section-title">Site allowlist</div>
        <p class="allowlist-help">
          Pages on these origins can run AGI automation in their tab. Add the current site, then
          reload it.
        </p>
        <div class="allowlist-current-row">
          <span class="allowlist-current-origin" id="allowlistCurrentOrigin">—</span>
          <button class="allowlist-toggle-btn" id="allowlistToggleBtn" disabled>Add</button>
        </div>
        <ul class="allowlist-list" id="allowlistList" aria-label="Allowlisted origins"></ul>
        <p class="allowlist-empty" id="allowlistEmpty" hidden>No sites allowlisted yet.</p>
      </div>

      <div class="divider"></div>

      <!-- Desktop Pairing -->
      <div class="info-section pairing-section">
        <div class="section-title">Desktop Pairing</div>
        <div class="pairing-status-row">
          <span class="pairing-status-label" id="pairingStatusLabel">Not paired</span>
          <span class="pairing-fingerprint" id="pairingFingerprint" hidden></span>
        </div>
        <p class="pairing-error" id="pairingError"></p>
        <div class="pairing-btn-row">
          <button class="pairing-btn primary" id="pairBtn">Pair with Desktop</button>
          <button class="pairing-btn danger" id="unpairBtn" hidden>Unpair</button>
        </div>
      </div>

      <div class="divider"></div>

      <!-- Page Information -->
      <div class="info-section">
        <div class="section-title">Current Page</div>
        <div class="info-item">
          <span class="info-label">Tab ID</span>
          <span class="info-value" id="tabId">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">URL</span>
          <span class="info-value" id="currentUrl" title="">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Version</span>
          <span class="info-value" id="extVersion">v…</span>
        </div>
        <div class="info-item" id="tierRow">
          <span class="info-label">Plan</span>
          <span class="info-value tier-badge" id="userTier" hidden></span>
        </div>
      </div>
    </div>

    <div class="footer">
      <p>
        Powered by
        <a href="https://agiworkforce.com" target="_blank" rel="noopener noreferrer">AGI</a>
      </p>
    </div>

    <script type="module" src="./popup.js"></script>
  </body>
</html>
"
`;

exports[`Chrome extension static HTML snapshots > locks the side_panel.html structure 1`] = `
"<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AGI</title>
    <!--
      M-08 audit 2026-05-19: minimal reset CSS extracted to side_panel.css.
      The rest of the side panel's styles are injected dynamically by
      side_panel.ts:injectStyles via Constructable Stylesheets
      (\`document.adoptedStyleSheets\`), which is CSP-compliant — no <style>
      tag is created at runtime.
    -->
    <link rel="stylesheet" href="./side_panel.css" />
  </head>
  <body>
    <script type="module" src="./side_panel.js"></script>
  </body>
</html>
"
`;
