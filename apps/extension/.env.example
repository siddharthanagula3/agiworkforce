# AGI Chrome extension — supported Vite/package environment
#
# All values below are public build configuration embedded in the extension.
# For local development, copy .env.local.example to .env.local.

# Hosted web origin used for CSRF, invite redemption, and product updates.
VITE_AGI_WEB_API_BASE_URL=https://agiworkforce.com

# Clerk Chrome Extension Native API configuration. Use the same Clerk instance
# as apps/web. Values must be absolute origins without paths or wildcards.
CLERK_PUBLISHABLE_KEY=pk_live_replace_with_matching_clerk_publishable_key
CLERK_FRONTEND_API=https://clerk.agiworkforce.com
CLERK_SYNC_HOST=https://clerk.agiworkforce.com

# Public key material used by Chrome to derive the stable production extension
# ID. Required by `pnpm package`; not needed for an unpacked development build.
CHROME_EXTENSION_PUBLIC_KEY=
