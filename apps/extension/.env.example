# Clerk Chrome Extension Native API publishable key.
# Configure the same Clerk instance used by apps/web and enable Native API in
# the Clerk Dashboard. This is public client configuration, never a secret key.
CLERK_PUBLISHABLE_KEY=

# Exact Clerk Frontend API origins for Native API and web-session Sync Host.
# Production example: https://clerk.agiworkforce.com (no path or wildcard).
CLERK_FRONTEND_API=
CLERK_SYNC_HOST=

# Public key material used by Chrome to derive a stable extension ID. This is
# required only for production packaging and must match the Chrome Web Store ID.
CHROME_EXTENSION_PUBLIC_KEY=
