{
  "name": "@agiworkforce/extension",
  "version": "1.2.0",
  "description": "Approved-site browser companion extension for AGI Desktop",
  "private": true,
  "type": "module",
  "author": "AGI",
  "license": "PROPRIETARY",
  "homepage": "https://agiworkforce.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharthanagula3/agiworkforce.git",
    "directory": "apps/extension"
  },
  "keywords": [
    "browser-automation",
    "chrome-extension",
    "desktop-integration",
    "accessibility",
    "native-messaging",
    "manifest-v3"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "pretest": "bash scripts/check-conflict-markers.sh",
    "test": "vitest run",
    "test:e2e": "pnpm build && node e2e/smoke.mjs",
    "clean": "rm -rf dist",
    "package": "pnpm build && node scripts/prepare-package.mjs && cd dist && zip -r ../extension.zip . -x '*.map'",
    "lint": "eslint src --ext .ts,.js --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,html}\"",
    "check:no-hex": "node scripts/check-no-hex-colors.mjs",
    "check:no-cloud-ipc": "node scripts/check-no-cloud-ipc-v1.mjs"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.52",
    "@agiworkforce/browser-tool": "workspace:*",
    "@agiworkforce/cloud-contracts": "workspace:*",
    "@agiworkforce/design-tokens": "workspace:*",
    "@agiworkforce/provider-runtime": "workspace:*",
    "@agiworkforce/routing": "workspace:*",
    "@agiworkforce/client-runtime": "workspace:*",
    "@agiworkforce/types": "workspace:*",
    "@agiworkforce/utils": "workspace:*",
    "dompurify": "^3.3.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "jsdom": "^27.4.0",
    "terser": "^5.46.2",
    "typescript": "5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.3"
  }
}
