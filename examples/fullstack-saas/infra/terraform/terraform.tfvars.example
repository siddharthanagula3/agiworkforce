container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/fullstack-saas:replace-me"
domain_name     = "app.example.com"
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"

environment_variables = {
  NODE_ENV                  = "production"
  LOG_LEVEL                 = "info"
  NEXT_PUBLIC_SUPABASE_URL  = "https://your-project.supabase.co"
  ALLOWED_ORIGINS           = "https://app.example.com"
}

secret_arns = {
  NEXT_PUBLIC_SUPABASE_ANON_KEY = "arn:aws:secretsmanager:us-east-1:123456789012:secret:supabase-anon"
  SUPABASE_SERVICE_ROLE_KEY     = "arn:aws:secretsmanager:us-east-1:123456789012:secret:supabase-service-role"
  SENTRY_DSN                    = "arn:aws:secretsmanager:us-east-1:123456789012:secret:sentry-dsn"
}
