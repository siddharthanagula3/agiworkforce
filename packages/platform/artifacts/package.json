{
  "name": "@agiworkforce/artifacts",
  "version": "0.0.1",
  "description": "Artifact derivation, client store, managed publish, and cloud merge and apply.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
