{
  "name": "@agiworkforce/key-value",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "KeyValue and RateLimit ports with Upstash, local Redis and in-memory adapters",
  "exports": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "peerDependencies": {
    "@upstash/ratelimit": ">=2.0.0",
    "@upstash/redis": ">=1.35.0",
    "ioredis": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "@upstash/ratelimit": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "ioredis": "^5.11.1",
    "vitest": "^4.1.11"
  }
}
