{
  "name": "@agiworkforce/object-storage",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "ObjectStore port with an S3-compatible adapter and an in-memory adapter",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {},
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.1000.0",
    "@aws-sdk/s3-request-presigner": ">=3.1000.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "vitest": "^4.1.8"
  }
}
