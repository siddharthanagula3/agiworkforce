{
  "name": "@agiworkforce/design-tokens",
  "version": "0.0.1",
  "description": "The only sanctioned source of color, spacing and type values. Presentation-only.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chat.css": "./src/chat.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  }
}
