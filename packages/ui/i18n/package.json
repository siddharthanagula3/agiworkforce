{
  "name": "@agiworkforce/i18n",
  "version": "0.0.1",
  "description": "Locale catalogues and message resolution shared by every surface; parity across locales is enforced by check:i18n-parity.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./resources": "./src/resources.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {}
}
