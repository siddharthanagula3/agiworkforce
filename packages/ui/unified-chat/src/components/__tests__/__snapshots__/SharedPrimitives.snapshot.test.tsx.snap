          class="inline-flex items-center gap-1 rounded-full border border-[var(--chat-border)] bg-[var(--chat-surface-overlay)] px-2 py-0.5 text-[12px] font-medium text-[var(--chat-text-secondary)]"
        >
          <svg
            aria-hidden="true"
