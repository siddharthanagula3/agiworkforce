        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect
          height="11"
          rx="2"
          ry="2"
          width="18"
          x="3"
          y="11"
        />
        <path
          d="M7 11V7a5 5 0 0 1 10 0v4"
        />
      </svg>
      BYOK
    </span>
    <span
      class="ml-auto shrink-0 text-[12px] text-[var(--chat-text-muted)]"
    >
      Direct Model Fixture
    </span>
  </div>
  <button
    aria-controls="send-preview-details"
    aria-expanded="false"
    class="inline-flex items-center gap-1 self-start text-[12px] font-medium uppercase tracking-wide text-[var(--chat-text-muted)] hover:text-[var(--chat-text-secondary)]"
    type="button"
  >
