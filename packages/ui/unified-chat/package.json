{
  "name": "@agiworkforce/unified-chat",
  "version": "0.0.1",
  "description": "Surface-neutral chat UI, stores and hooks shared by desktop, web, Chrome and VS Code.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./model-picker": "./src/lib/modelPicker.ts",
    "./network-error": "./src/lib/network-error.ts",
    "./composer-editor": "./src/composer-editor/index.ts",
    "./composer-editor.css": "./src/composer-editor/composer-editor.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0",
    "test": "vitest run",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@agiworkforce/client-runtime": "workspace:*",
    "@agiworkforce/design-tokens": "workspace:*",
    "@agiworkforce/routing": "workspace:*",
    "@agiworkforce/search": "workspace:*",
    "@agiworkforce/types": "workspace:*",
    "@agiworkforce/ui": "workspace:*",
    "@agiworkforce/utils": "workspace:*",
    "@shikijs/langs": "~4.4.3",
    "@shikijs/themes": "~4.4.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "~4.4.3",
    "simple-icons": "^16.30.0",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cmdk": ">=1.0.0",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": ">=1.0.0"
  }
