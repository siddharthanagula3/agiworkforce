{
  "name": "@agiworkforce/client-runtime",
  "version": "0.0.1",
  "description": "Client runtime detection, command dispatch, shared state, and the offline queue.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./state": "./src/state/index.ts",
    "./queue": "./src/queue/index.ts",
    "./offline-queue": "./src/offline-queue/index.ts",
    "./offline-sync": "./src/offline-sync/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/types": "workspace:*"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
