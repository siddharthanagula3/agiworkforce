{
  "name": "@agiworkforce/ide-runtime",
  "version": "0.0.1",
  "description": "IDE-neutral CodeSession runtime: selection, diagnostics, diff and terminal/process shapes an editor integration adapts its host objects into. Imports no editor SDK.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/utils": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
