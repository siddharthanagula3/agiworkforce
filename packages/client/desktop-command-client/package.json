{
  "name": "@agiworkforce/desktop-command-client",
  "version": "0.0.1",
  "description": "Typed transport from the desktop renderer to the privileged Rust host.",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/client-runtime": "workspace:*",
    "@agiworkforce/types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
