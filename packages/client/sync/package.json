{
  "name": "@agiworkforce/sync",
  "version": "0.0.1",
  "description": "Managed-cloud delta validation and local apply, with a bigint cursor; pinned to the Rust apply by golden fixtures.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/cloud-contracts": "workspace:*"
  },
  "devDependencies": {
    "@agiworkforce/artifacts": "workspace:*",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
