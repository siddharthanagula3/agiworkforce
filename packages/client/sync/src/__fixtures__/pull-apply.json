    {
      "name": "orphan_message_then_parent_conversation_arrives",
      "applies": ["ts", "rust"],
      "divergenceNote": "Same END state on both engines, reached differently. TS's message port has no FK constraint: after step 1 alone the message is ALREADY visible under conversation id 'c-orphan' (see the extra TS-only intermediate assertion in fixtures.test.ts). Rust's SQLite schema enforces a real foreign key: after step 1 alone the message is buffered in cloud_sync_pending_messages and NOT yet a row in `messages` (see the extra Rust-only intermediate assertion in the fixture-replay test), it is drained into a real row only when step 2 applies the parent conversation. Replayed through apply_pull_page (not the individual fns) specifically so this conv-then-drain-then-msg ordering is exercised.",
      "dirtyConversationIds": [],
      "initialConversations": [],
      "initialMessages": {},
      "steps": [
        {
          "conversations": [],
          "messages": [
            {
              "id": "m1",
              "conversation_id": "c-orphan",
              "role": "user",
              "content": "arrived early",
              "model": null,
              "provider": null,
              "input_tokens": 0,
              "output_tokens": 0,
              "metadata": null,
              "created_at": "2026-07-01T00:00:00.000Z",
              "updated_at": "2026-07-01T00:00:00.000Z",
              "deleted_at": null,
              "server_version": "5"
            }
          ],
          "artifacts": []
        },
        {
