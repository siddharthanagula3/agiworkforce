{
  "name": "@agiworkforce/types",
  "version": "0.0.1",
  "description": "Cross-surface contracts, generated protocol bindings, and the trust-boundary invariants everything else depends on.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./models.json": "./src/models.json",
    "./protocol": "./src/generated/protocol/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/model-registry": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
