{
  "columnContract": {
    "baselineMigration": 239,
    "roles": {
      "owner": {
        "column": "user_id",
        "why": "the account the row belongs to, the value every RLS policy compares against"
      },
      "tenant": {
        "column": "organization_id",
        "why": "the organization the row is scoped to, null for a personal row"
      },
      "parent": {
        "column": "conversation_id",
        "why": "the owning row, for a child object that has no owner of its own"
      },
      "project": {
        "column": "project_id",
        "why": "the project the row is filed under, null when it is loose"
      },
      "createdBy": {
        "column": "created_by",
        "why": "the principal that created the row, which is not always its owner"
      },
      "updatedBy": {
        "column": "updated_by",
        "why": "the principal that last wrote the row"
      },
      "version": {
        "column": "server_version",
        "why": "the optimistic-concurrency token an If-Match precondition quotes"
      },
      "createdAt": {
        "column": "created_at",
        "why": "when the row came into existence"
      },
      "updatedAt": {
        "column": "updated_at",
        "why": "when the row was last written"
      },
      "deletedAt": {
        "column": "deleted_at",
        "why": "when the row was soft deleted, null while it is alive"
      },
      "originSurface": {
        "column": "origin_surface",
        "why": "which product surface produced the row"
      }
    }
  },
