{
  "name": "@agiworkforce/local-runtime-contract",
  "version": "0.0.1",
  "description": "Typed contract for the privileged Electron local runtime. Pure types and validation; performs no I/O.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
