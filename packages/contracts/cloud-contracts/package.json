{
  "name": "@agiworkforce/cloud-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./me": "./src/me.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "me": [
        "./src/me.ts"
      ],
      "*": [
        "./src/index.ts"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/types": "workspace:*",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
