{
  "name": "@agiworkforce/guardian-github",
  "version": "0.0.1",
  "description": "GitHub delivery surface for Guardian: webhook intake, check runs, and PR summaries built on @agiworkforce/guardian-core.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./webhook": "./src/webhook.ts",
    "./events": "./src/events.ts",
    "./commands": "./src/commands.ts",
    "./checks": "./src/checks.ts",
    "./summary": "./src/summary.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0",
    "scan": "tsx src/cli/scan.ts"
  },
  "dependencies": {
    "@agiworkforce/guardian-core": "workspace:*",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^4.1.8"
  }
}
