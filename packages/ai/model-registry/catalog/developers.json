    "mistral": { "label": "Mistral AI", "aliases": ["mistral", "mistralai"] },
    "zhipu": { "label": "Z.AI", "aliases": ["z-ai", "zhipu", "zhipuai", "zai-org", "thudm"] },
    "moonshot": { "label": "Moonshot AI", "aliases": ["moonshot", "moonshotai"] },
    "minimax": { "label": "MiniMax", "aliases": ["minimax", "minimaxai"] },
    "nvidia": { "label": "NVIDIA", "aliases": ["nvidia"] },
    "xai": { "label": "xAI", "aliases": ["xai", "x-ai"] },
    "perplexity": { "label": "Perplexity", "aliases": ["perplexity"] },
    "cohere": { "label": "Cohere", "aliases": ["cohere"] },
