  "$schema": "../schema/registry.schema.json",
  "schemaVersion": 1,
  "governance": {
    "managed_cloud": {
      "dataRetentionClass": "unknown",
      "zeroDataRetentionAvailability": "unknown",
      "trainsOnInputs": "unknown",
      "residencyRegions": null
    },
    "openai": {
      "dataRetentionClass": "provider_default",
      "zeroDataRetentionAvailability": "on_request",
      "trainsOnInputs": "never",
      "residencyRegions": ["us", "eu", "ae"],
      "source": "https://developers.openai.com/api/docs/guides/your-data",
      "verifiedOn": "2026-09-05",
      "note": "Abuse-monitoring logs are held up to 30 days unless the law requires longer. Zero data retention needs prior approval and drops the request from those logs. Regional processing covers the United States, the European Economic Area with Switzerland, and the United Arab Emirates; the other listed regions are storage only."
    },
    "anthropic": {
      "dataRetentionClass": "provider_default",
      "zeroDataRetentionAvailability": "on_request",
      "trainsOnInputs": "never",
      "residencyRegions": null,
      "source": "https://privacy.claude.com/en/articles/7996866-how-long-do-you-store-personal-data",
      "verifiedOn": "2026-09-05",
      "note": "API inputs and outputs are deleted within 30 days of receipt, with exceptions for the Files API, custom agreements, usage-policy enforcement and legal holds. Zero data retention exists as a separate agreement. No residency region list is published."
    },
    "google": {
      "dataRetentionClass": "provider_default",
      "zeroDataRetentionAvailability": "unknown",
      "trainsOnInputs": "never",
      "residencyRegions": null,
      "source": "https://ai.google.dev/gemini-api/terms",
      "verifiedOn": "2026-09-05",
      "note": "On the paid tier Google does not use prompts, cached content, files or responses to improve its products. Prompts and responses are still logged for a limited period to detect abuse. The terms name no zero-retention option and no region list."
    },
    "open_router": {
      "dataRetentionClass": "conditional",
      "zeroDataRetentionAvailability": "per_request_setting",
      "trainsOnInputs": "varies_by_route",
      "residencyRegions": ["us", "eu"],
      "source": "https://openrouter.ai/docs/features/privacy-and-logging",
      "verifiedOn": "2026-09-05",
      "note": "Zero retention is a per-request or per-account data policy that restricts the upstream pool, not a default, and the docs state the setting has no bearing on OpenRouter's own handling. Regional processing is enterprise-only. Our adapter sends the deny policy only when a caller supplies it, so no route here guarantees zero retention today."
    },
