{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agiworkforce.com/schemas/model-registry/v1.json",
  "title": "AGI Workforce model registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "models",
    "providerModelKeys",
    "routes",
    "harnesses",
    "runtimeProfiles",
    "capabilities",
    "capabilityClasses",
    "governance",
    "providerDefaults",
    "computePricing",
    "endpointHosts",
    "pricing",
    "limits",
    "benchmarks",
    "evidence",
    "families",
    "policies"
  ],
  "properties": {
    "$schema": {
      "const": "../schema/registry.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/model"
      }
    },
    "providerModelKeys": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/route"
      }
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/harness"
      }
    },
    "runtimeProfiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/runtimeProfile"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/capabilities"
      }
    },
    "capabilityClasses": {
      "$ref": "#/definitions/capabilityClasses"
    },
    "governance": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/providerGovernance"
      }
    },
    "providerDefaults": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/providerDefaults"
      }
    },
    "computePricing": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/providerComputePricing"
      }
    },
    "endpointHosts": {
      "$ref": "#/definitions/endpointHosts"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/pricing"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/limits"
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/benchmarkScore"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/evidence"
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/familySlot"
      }
    },
    "policies": {
      "$ref": "#/definitions/policies"
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "trustMode": {
      "enum": ["local", "on_device", "byok", "managed_cloud"]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "lifecycle", "evidenceRefs"],
      "properties": {
        "identity": {
          "$ref": "#/definitions/modelIdentity"
        },
        "lifecycle": {
          "$ref": "#/definitions/lifecycle"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "displayName",
        "provider",
        "providerModelId",
        "kind",
        "aliases",
        "family"
      ],
      "properties": {
        "key": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "displayName": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "provider": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "providerModelId": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "openRouterSlug": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "role": {
          "enum": ["router"],
          "description": "Set only for a model entry that is itself a routing endpoint rather than a single served model, so a picker can filter it out of or into a routers-only view. Absent for every ordinary model."
        },
        "familyPartner": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "openWeight": {
          "type": "boolean"
        },
        "license": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "commercialRestrictions": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "description": "Every string that resolves to this model: its provider-native id, its OpenRouter slug, and every canonicalization key pointed at it. Compiled, never authored directly.",
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "family": {
          "type": ["string", "null"],
          "description": "The canonical family this model belongs to, resolved from model-families.json. null when the model occupies no family slot."
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "availability",
        "deprecated",
        "releasedOn",
        "deprecatedOn",
        "stage",
        "stagedOn",
        "stageSource"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "availability": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "unavailableReason": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "released": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "deprecationDate": {
          "type": ["string", "null"]
        },
        "releasedOn": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "The release date as a calendar day. null when the authored prose carries no resolvable day."
        },
        "deprecatedOn": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "The deprecation date as a calendar day. null when none is published."
        },
        "deprecated": {
          "type": "boolean"
        },
        "stage": {
          "type": "string",
          "enum": [
            "discovered",
            "registered",
            "probed",
            "benchmarked",
            "evaluated",
            "shadow",
            "canary",
            "promoted",
            "observed",
            "deprecated",
            "removed"
          ],
          "description": "The lifecycle stage this model has actually reached."
        },
        "stagedOn": {
          "$ref": "#/definitions/isoDate",
          "description": "The calendar day the model entered its current stage."
        },
        "stageSource": {
          "$ref": "#/definitions/nonEmptyString",
          "description": "What justifies the stage: a slot, a probe record, or the source of the scores it was evaluated on."
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelKey",
        "provider",
        "providerModelId",
        "harnessId",
        "trustModes",
        "availability",
        "selectable",
        "isDefault",
        "cacheClass",
        "commercialStatus",
        "dataRetention",
        "pricing"
      ],
      "properties": {
        "modelKey": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "provider": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "providerModelId": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "harnessId": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "trustModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/trustMode"
          }
        },
        "availability": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "selectable": {
          "type": "boolean"
        },
        "isDefault": {
          "type": "boolean",
          "description": "True for the route on the model's own canonical provider. Exactly one route per model carries it, and its id is the historic `${provider}/${modelKey}` key."
        },
        "cacheClass": {
          "$ref": "#/definitions/routeCacheClass"
        },
        "commercialStatus": {
          "$ref": "#/definitions/routeCommercialStatus"
        },
        "dataRetention": {
          "$ref": "#/definitions/routeDataRetention"
        },
        "pricing": {
          "$ref": "#/definitions/pricing"
        }
      }
    },
    "routeCacheClass": {
      "enum": [
        "provider_implicit_prompt_cache",
        "provider_explicit_prompt_cache",
        "gateway_prompt_cache",
        "gateway_response_cache",
        "no_provider_cache"
      ]
    },
    "routeCommercialStatus": {
      "enum": [
        "agi_direct",
        "customer_byok",
        "authorized_marketplace",
        "free_commercial",
        "experimental_only",
        "blocked"
      ]
    },
    "routeDataRetention": {
      "enum": ["zero_retention", "provider_default", "conditional", "unknown"]
    },
    "harnessProtocol": {
      "enum": [
        "openai_chat",
        "openai_responses",
        "anthropic_messages",
        "gemini_native",
        "provider_native"
      ]
    },
    "harnessHostPolicy": {
      "enum": ["allowlist_only", "registry_declared"]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "apiFamily",
        "adapter",
        "trustModes",
        "features",
        "protocol",
        "hostPolicy"
      ],
      "properties": {
        "provider": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "apiFamily": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "adapter": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "protocol": {
          "$ref": "#/definitions/harnessProtocol"
        },
        "hostPolicy": {
          "$ref": "#/definitions/harnessHostPolicy"
        },
        "baseUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "apiKeyEnv": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "trustModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/trustMode"
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/harnessFeature"
          }
        }
      }
    },
    "harnessFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerSupport", "implementation"],
      "properties": {
        "providerSupport": {
          "enum": ["native", "compatible", "agi", "unsupported", "unknown"]
        },
        "implementation": {
          "enum": ["implemented", "partial", "unwired", "unavailable", "unknown"]
        }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "surface",
        "executionMode",
        "trustMode",
        "status",
        "features",
        "allowedHarnessIds"
      ],
      "properties": {
        "family": {
          "enum": ["consumer", "work", "developer", "browser"]
        },
        "surface": {
          "enum": ["web", "desktop", "mobile", "cli", "vscode", "chrome"]
        },
        "executionMode": {
          "enum": ["local", "cloud"]
        },
        "trustMode": {
          "$ref": "#/definitions/trustMode"
        },
        "status": {
          "enum": ["implemented", "partial", "unwired", "unavailable"]
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/runtimeFeature"
          }
        },
        "allowedHarnessIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "runtimeFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation"],
      "properties": {
        "implementation": {
          "enum": ["implemented", "partial", "unwired", "unavailable", "unknown"]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "description": "One capability vocabulary. Every name is required; null is an explicit unknown, never a guessed false.",
      "required": [
        "textInput",
        "imageInput",
        "audioInput",
        "videoInput",
        "textOutput",
        "imageOutput",
        "audioOutput",
        "videoOutput",
        "streaming",
        "structuredOutput",
        "functionCalling",
        "reasoning",
        "imageEditing",
        "realtime",
        "reranking",
        "toolSchemaSupport",
        "computerUse",
        "agentic",
        "webSearch",
        "deepResearch",
        "codeExecution",
        "promptCaching"
      ],
      "properties": {
        "textInput": {
          "type": "boolean"
        },
        "imageInput": {
          "type": "boolean"
        },
        "audioInput": {
          "type": "boolean"
        },
        "videoInput": {
          "type": "boolean"
        },
        "textOutput": {
          "type": "boolean"
        },
        "imageOutput": {
          "type": "boolean"
        },
        "audioOutput": {
          "type": "boolean"
        },
        "videoOutput": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        },
        "structuredOutput": {
          "type": "boolean"
        },
        "functionCalling": {
          "type": "boolean"
        },
        "reasoning": {
          "type": "boolean"
        },
        "imageEditing": {
          "type": ["boolean", "null"],
          "description": "null records an unverified fact; consumers treat it as not offered."
        },
        "realtime": {
          "type": ["boolean", "null"],
          "description": "null records an unverified fact; consumers treat it as not offered."
        },
        "reranking": {
          "type": ["boolean", "null"],
          "description": "null records an unverified fact; consumers treat it as not offered."
        },
        "toolSchemaSupport": {
          "type": ["boolean", "null"],
          "description": "null records an unverified fact; consumers treat it as not offered."
        },
        "computerUse": {
          "type": "boolean"
        },
        "agentic": {
          "type": "boolean"
        },
        "webSearch": {
          "type": "boolean"
        },
        "deepResearch": {
          "type": "boolean"
        },
        "codeExecution": {
          "type": "boolean"
        },
        "promptCaching": {
          "type": "boolean"
        }
      }
    },
    "providerDefaultEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "The model a provider serves for one capability when the caller names none. Authored against a family slot so a promotion never reaches this record.",
      "required": ["modelKey", "source", "verifiedOn"],
      "properties": {
        "modelKey": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "verifiedOn": {
          "$ref": "#/definitions/isoDate"
        },
        "note": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "providerDefaults": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/providerDefaultEntry"
      }
    },
    "providerGovernance": {
      "type": "object",
      "additionalProperties": false,
      "description": "One provider's published data-governance terms. Every field is required; unknown is an explicit unknown, never a guess. source and verifiedOn are required as soon as any field carries a verified answer. cacheTokenBillingClass carries its own source/verifiedOn/note because it is typically read from a different page than retention, on a different date.",
      "required": [
        "dataRetentionClass",
        "zeroDataRetentionAvailability",
        "trainsOnInputs",
        "residencyRegions",
        "cacheTokenBillingClass"
      ],
      "properties": {
        "dataRetentionClass": {
          "enum": ["zero_retention", "provider_default", "conditional", "unknown"]
        },
        "zeroDataRetentionAvailability": {
          "enum": ["default", "on_request", "per_request_setting", "unavailable", "unknown"]
        },
        "trainsOnInputs": {
          "enum": ["never", "opt_in", "opt_out", "varies_by_route", "unknown"]
        },
        "residencyRegions": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "description": "Regions the provider offers for processing. null records an unverified fact.",
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "verifiedOn": {
          "$ref": "#/definitions/isoDate"
        },
        "note": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "cacheTokenBillingClass": {
          "description": "Whether this provider's usage object reports prompt-cache tokens as additional to its base input/prompt token count, or already included within it. Drives whether cache tokens count toward volume pricing tiers and toward the cache-write fallback multiplier.",
          "enum": ["additional_to_input", "included_in_input", "unknown"]
        },
        "cacheTokenBillingSource": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "cacheTokenBillingVerifiedOn": {
          "$ref": "#/definitions/isoDate"
        },
        "cacheTokenBillingNote": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "providerComputePricing": {
      "type": "object",
      "additionalProperties": false,
      "description": "One non-LLM compute provider's published unit price, for metering costs that are not per-token (e.g. sandbox seconds). source and verifiedOn are always required, there is no unverified state for a priced entry.",
      "required": ["unit", "ratePerUnit", "source", "verifiedOn"],
      "properties": {
        "unit": {
          "enum": ["usd_per_vcpu_second"]
        },
        "ratePerUnit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "verifiedOn": {
          "$ref": "#/definitions/isoDate"
        },
        "note": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "benchmarkScore": {
      "type": "object",
      "additionalProperties": false,
      "description": "One benchmark result and where it came from. version and date are null when the source publishes none; an unsourced score is refused at compile.",
      "required": ["value", "source", "version", "date", "confidence"],
      "properties": {
        "value": {
          "type": "number"
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "version": {
          "type": ["string", "null"]
        },
        "date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "confidence": {
          "enum": ["verified", "aggregated", "unknown"]
        }
      }
    },
    "endpointHostRule": {
      "type": "object",
      "additionalProperties": false,
      "description": "One rule mapping a provider endpoint to its payload-policy class. match host compares the hostname exactly, hostSuffix compares the tail, domain matches the domain or any subdomain, baseUrl compares the whole normalized URL.",
      "required": ["match", "pattern", "endpointClass", "longTtlPromptCache"],
      "properties": {
        "match": {
          "enum": ["host", "hostSuffix", "domain", "baseUrl"]
        },
        "pattern": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "endpointClass": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "longTtlPromptCache": {
          "type": "boolean"
        },
        "hostPattern": {
          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "endpointHosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "localHosts", "localHostSuffixes"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/endpointHostRule"
          }
        },
        "localHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "localHostSuffixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "capabilityClasses": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which capability names are model-intrinsic and which depend on a provider route or an AGI harness. A route-dependent name is never sufficient on its own; the harness feature still gates it.",
      "required": ["intrinsic", "routeDependent"],
      "properties": {
        "intrinsic": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "routeDependent": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "unit"],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "unit": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "inputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheReadPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWritePerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWrite1hPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "imagePerImage": {
          "type": "number",
          "minimum": 0
        },
        "videoPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "videoPerSecondByResolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "480p": {
              "type": "number",
              "minimum": 0
            },
            "720p": {
              "type": "number",
              "minimum": 0
            },
            "1080p": {
              "type": "number",
              "minimum": 0
            },
            "4k": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "videoTokenFormula": {
          "$ref": "#/definitions/videoTokenFormula"
        },
        "promoExpiresAt": {
          "type": ["string", "null"]
        },
        "postPromoPrices": {
          "type": ["object", "null"]
        },
        "inputTokenPricingTiers": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered provider-published price bands. The compiler additionally requires strictly increasing thresholds; consumers select the greatest threshold strictly below total request input tokens.",
          "items": {
            "$ref": "#/definitions/inputTokenPricingTier"
          }
        },
        "longContext": {
          "description": "Deprecated read-compatibility singleton. Current generated entries use inputTokenPricingTiers.",
          "$ref": "#/definitions/inputTokenPricingTier"
        },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "description": "Dated pricing windows. effectiveFrom/effectiveUntil are UTC calendar days and both bounds are inclusive, so a changeover happens at UTC midnight. Windows must not overlap; the first window covering a date wins, and the top-level fields are the fallback for any rate a window omits.",
          "items": {
            "$ref": "#/definitions/pricingScheduleEntry"
          }
        }
      }
    },
    "videoTokenFormula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "framesPerSecond", "pixelsPerToken", "usdPerToken"],
      "properties": {
        "unit": {
          "const": "video_tokens"
        },
        "framesPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "pixelsPerToken": {
          "type": "integer",
          "minimum": 1
        },
        "usdPerToken": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "usdPerTokenWithoutAudio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "usdPerTokenWithVideoInput": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "inputTokenPricingTier": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provider-published rates admitted once total input tokens cross thresholdTokens; thresholdBoundary states whether the crossing point itself is included (defaults to exclusive, strictly above, when absent).",
      "required": ["thresholdTokens", "inputPerMillion", "outputPerMillion"],
      "properties": {
        "thresholdTokens": {
          "type": "integer",
          "minimum": 1
        },
        "thresholdBoundary": {
          "enum": ["inclusive", "exclusive"]
        },
        "inputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheReadPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWritePerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWrite1hPerMillion": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pricingScheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "One dated pricing window. effectiveFrom and effectiveUntil are UTC calendar days, inclusive on both sides; changeovers happen at UTC midnight.",
