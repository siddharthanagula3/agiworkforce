      "properties": {
        "resolution": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "aspectRatio": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "durationSecs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
