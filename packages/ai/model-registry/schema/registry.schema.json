          "$ref": "#/definitions/nonEmptyString"
        },
        "lifecyclePolicy": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "activeModelKey": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "activeGeneration": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "activeLifecycle": {
          "type": ["string", "null"]
        },
        "previousModelKey": {
          "type": ["string", "null"]
        },
        "fallbackChain": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "promotedAt": {
          "type": ["string", "null"]
        },
        "promotionReason": {
          "type": ["string", "null"]
        }
      }
