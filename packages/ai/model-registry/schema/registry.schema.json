        "effectiveFrom": {
          "$ref": "#/definitions/isoDate"
        },
        "effectiveUntil": {
          "$ref": "#/definitions/isoDate"
        },
        "note": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "inputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheReadPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWritePerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cacheWrite1hPerMillion": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
