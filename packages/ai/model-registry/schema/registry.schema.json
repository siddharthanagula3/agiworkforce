{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agiworkforce.com/schemas/model-registry/v1.json",
  "title": "AGI Workforce model registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "models",
    "providerModelKeys",
    "routes",
    "harnesses",
    "runtimeProfiles",
    "capabilities",
    "pricing",
    "limits",
    "benchmarks",
    "evidence",
    "policies"
  ],
  "properties": {
    "$schema": { "const": "../schema/registry.schema.json" },
    "schemaVersion": { "const": 1 },
    "models": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/model" }
    },
    "providerModelKeys": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/route" }
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/harness" }
    },
    "runtimeProfiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/runtimeProfile" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/capabilities" }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/pricing" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/limits" }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence" }
    },
    "policies": { "$ref": "#/definitions/policies" }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "trustMode": {
      "enum": ["local", "on_device", "byok", "managed_cloud"]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "lifecycle", "evidenceRefs"],
      "properties": {
        "identity": { "$ref": "#/definitions/modelIdentity" },
        "lifecycle": { "$ref": "#/definitions/lifecycle" },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "displayName", "provider", "providerModelId", "kind"],
      "properties": {
        "key": { "$ref": "#/definitions/nonEmptyString" },
        "displayName": { "$ref": "#/definitions/nonEmptyString" },
        "provider": { "$ref": "#/definitions/nonEmptyString" },
        "providerModelId": { "$ref": "#/definitions/nonEmptyString" },
        "kind": { "$ref": "#/definitions/nonEmptyString" },
        "familyPartner": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "availability", "deprecated"],
      "properties": {
        "status": { "$ref": "#/definitions/nonEmptyString" },
        "availability": { "$ref": "#/definitions/nonEmptyString" },
        "unavailableReason": { "$ref": "#/definitions/nonEmptyString" },
        "released": { "$ref": "#/definitions/nonEmptyString" },
        "deprecationDate": { "type": ["string", "null"] },
        "deprecated": { "type": "boolean" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelKey",
        "provider",
        "providerModelId",
        "harnessId",
        "trustModes",
        "availability",
        "selectable"
      ],
      "properties": {
        "modelKey": { "$ref": "#/definitions/nonEmptyString" },
        "provider": { "$ref": "#/definitions/nonEmptyString" },
        "providerModelId": { "$ref": "#/definitions/nonEmptyString" },
        "harnessId": { "$ref": "#/definitions/nonEmptyString" },
        "trustModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/trustMode" }
        },
        "availability": { "$ref": "#/definitions/nonEmptyString" },
        "selectable": { "type": "boolean" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "apiFamily", "adapter", "trustModes", "features"],
      "properties": {
        "provider": { "$ref": "#/definitions/nonEmptyString" },
        "apiFamily": { "$ref": "#/definitions/nonEmptyString" },
        "adapter": { "$ref": "#/definitions/nonEmptyString" },
        "trustModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/trustMode" }
        },
        "features": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/harnessFeature" }
        }
      }
    },
    "harnessFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerSupport", "implementation"],
      "properties": {
        "providerSupport": {
          "enum": ["native", "compatible", "agi", "unsupported", "unknown"]
        },
        "implementation": {
          "enum": ["implemented", "partial", "unwired", "unavailable", "unknown"]
        }
      }
    },
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "surface",
        "executionMode",
        "trustMode",
        "status",
        "features",
        "allowedHarnessIds"
      ],
      "properties": {
        "family": {
          "enum": ["consumer", "work", "developer", "browser"]
        },
        "surface": {
          "enum": ["web", "desktop", "mobile", "cli", "vscode", "chrome"]
        },
        "executionMode": {
          "enum": ["local", "cloud"]
        },
        "trustMode": { "$ref": "#/definitions/trustMode" },
        "status": {
          "enum": ["implemented", "partial", "unwired", "unavailable"]
        },
        "features": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/runtimeFeature" }
        },
        "allowedHarnessIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "runtimeFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation"],
      "properties": {
        "implementation": {
          "enum": ["implemented", "partial", "unwired", "unavailable", "unknown"]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textInput",
        "imageInput",
        "audioInput",
        "videoInput",
        "textOutput",
        "imageOutput",
        "audioOutput",
        "videoOutput",
        "streaming",
        "structuredOutput",
        "functionCalling",
        "reasoning"
      ],
      "properties": {
        "textInput": { "type": "boolean" },
        "imageInput": { "type": "boolean" },
        "audioInput": { "type": "boolean" },
        "videoInput": { "type": "boolean" },
        "textOutput": { "type": "boolean" },
        "imageOutput": { "type": "boolean" },
        "audioOutput": { "type": "boolean" },
        "videoOutput": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "structuredOutput": { "type": "boolean" },
        "functionCalling": { "type": "boolean" },
        "reasoning": { "type": "boolean" }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "unit"],
      "properties": {
        "currency": { "const": "USD" },
        "unit": { "$ref": "#/definitions/nonEmptyString" },
        "inputPerMillion": { "type": "number", "minimum": 0 },
        "outputPerMillion": { "type": "number", "minimum": 0 },
        "cacheReadPerMillion": { "type": "number", "minimum": 0 },
        "cacheWritePerMillion": { "type": "number", "minimum": 0 },
        "cacheWrite1hPerMillion": { "type": "number", "minimum": 0 },
        "imagePerImage": { "type": "number", "minimum": 0 },
        "videoPerSecond": { "type": "number", "minimum": 0 },
        "videoPerSecondByResolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "720p": { "type": "number", "minimum": 0 },
            "1080p": { "type": "number", "minimum": 0 },
            "4k": { "type": "number", "minimum": 0 }
          }
        },
        "promoExpiresAt": { "type": ["string", "null"] },
        "postPromoPrices": { "type": ["object", "null"] }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contextTokens": { "type": "integer", "minimum": 1 },
        "maxInputTokens": { "type": "integer", "minimum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "knowledgeCutoff": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto", "legacyTiers"],
      "properties": {
        "auto": { "$ref": "#/definitions/autoPolicy" },
        "legacyTiers": { "type": "object" }
      }
    },
    "routingProfile": {
      "enum": ["economy", "balanced", "premium"]
    },
    "autoPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "defaultAlias",
        "fallbackSlot",
        "profileOrder",
        "tierMaximumProfiles",
        "tierAllowedSlots",
        "providerPolicies",
        "aliases",
        "continuity",
        "tasks",
        "slots"
      ],
      "properties": {
        "kind": { "const": "routing_policy" },
        "defaultAlias": { "$ref": "#/definitions/nonEmptyString" },
        "fallbackSlot": { "$ref": "#/definitions/nonEmptyString" },
        "profileOrder": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/routingProfile" }
        },
        "tierMaximumProfiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/routingProfile" }
        },
        "tierAllowedSlots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        "providerPolicies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usOnly"],
          "properties": {
            "usOnly": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allowedTiers", "excludedProviders"],
              "properties": {
                "allowedTiers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/definitions/nonEmptyString" }
                },
                "excludedProviders": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/definitions/nonEmptyString" }
                }
              }
            }
          }
        },
        "aliases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "label", "description", "selectable"],
            "properties": {
              "profile": { "$ref": "#/definitions/routingProfile" },
              "label": { "$ref": "#/definitions/nonEmptyString" },
              "description": { "$ref": "#/definitions/nonEmptyString" },
              "selectable": { "type": "boolean" }
            }
          }
        },
        "continuity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preserveExplicitSelection",
            "preferCurrentModelWhenEligible",
            "preferCurrentRouteForCache",
            "reevaluateOnTaskChange"
          ],
          "properties": {
            "preserveExplicitSelection": { "type": "boolean" },
            "preferCurrentModelWhenEligible": { "type": "boolean" },
            "preferCurrentRouteForCache": { "type": "boolean" },
            "reevaluateOnTaskChange": { "type": "boolean" }
          }
        },
        "tasks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/autoTaskPolicy" }
        },
        "slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/autoSlot" }
        }
      }
    },
    "autoTaskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCapabilities",
        "requiredHarnessFeatures",
        "preferredSlots",
        "benchmarkWeights"
      ],
      "properties": {
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "requiredHarnessFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "minimumContextTokens": { "type": "integer", "minimum": 1 },
        "preferredSlots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["economy", "balanced", "premium"],
          "properties": {
            "economy": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/nonEmptyString" }
            },
            "balanced": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/nonEmptyString" }
            },
            "premium": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/nonEmptyString" }
            }
          }
        },
        "benchmarkWeights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "autoSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelKey", "label", "description"],
      "properties": {
        "modelKey": { "$ref": "#/definitions/nonEmptyString" },
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "description": { "$ref": "#/definitions/nonEmptyString" }
      }
    }
  }
}
