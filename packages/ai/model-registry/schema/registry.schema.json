            "type": "integer",
            "minimum": 1
          }
        },
        "outputSizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/videoOutputSize"
          }
        },
        "supportsAudio": {
          "type": "boolean"
        },
        "supportsSeed": {
          "type": "boolean"
        }
      }
    },
    "videoOutputSize": {
      "type": "object",
      "additionalProperties": false,
