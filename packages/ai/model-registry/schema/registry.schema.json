        },
        "legacyTiers": {
          "type": "object"
        }
      }
    },
    "routingProfile": {
      "enum": ["economy", "balanced", "premium"]
    },
    "autoPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "defaultAlias",
        "fallbackSlot",
        "profileOrder",
        "tierMaximumProfiles",
        "tierAllowedSlots",
        "providerPolicies",
        "aliases",
        "continuity",
        "tasks",
        "slots"
      ],
      "properties": {
        "kind": {
          "const": "routing_policy"
        },
        "defaultAlias": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "fallbackSlot": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "autoProfileByTask": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/routingProfile"
          }
        },
        "profileOrder": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/routingProfile"
          }
        },
        "tierMaximumProfiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/routingProfile"
          }
        },
        "tierAllowedSlots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/nonEmptyString"
            }
          }
        },
        "providerPolicies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["usOnly"],
          "properties": {
            "usOnly": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allowedTiers", "excludedProviders"],
              "properties": {
                "allowedTiers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/nonEmptyString"
                  }
                },
                "excludedProviders": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/nonEmptyString"
                  }
                }
              }
            }
          }
        },
        "aliases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "label", "description", "selectable"],
            "properties": {
              "profile": {
                "$ref": "#/definitions/routingProfile"
              },
              "label": {
                "$ref": "#/definitions/nonEmptyString"
              },
              "description": {
                "$ref": "#/definitions/nonEmptyString"
              },
              "selectable": {
                "type": "boolean"
              },
              "computeProfile": {
                "type": "boolean"
              }
            }
          }
        },
        "continuity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preserveExplicitSelection",
            "preferCurrentModelWhenEligible",
            "preferCurrentRouteForCache",
            "reevaluateOnTaskChange"
          ],
          "properties": {
            "preserveExplicitSelection": {
              "type": "boolean"
            },
            "preferCurrentModelWhenEligible": {
              "type": "boolean"
            },
            "preferCurrentRouteForCache": {
              "type": "boolean"
            },
            "reevaluateOnTaskChange": {
              "type": "boolean"
            }
          }
        },
        "tasks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/autoTaskPolicy"
          }
        },
        "slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/autoSlot"
          }
        },
        "taskFamilies": {
          "type": "object",
          "minProperties": 1,
          "description": "Optional. Narrower task families layered on top of the canonical task taxonomy, each with a quality floor for the deterministic task-family ordering stage (packages/ai/routing/src/task-family-routing.ts). Families NEVER participate in admission: a family only reorders the candidate set its declared task type already produced, and the stage is off unless AGI_ROUTING_TASK_FAMILY_STAGE=1.",
          "additionalProperties": {
            "$ref": "#/definitions/autoTaskFamily"
          }
        }
      }
    },
    "autoTaskFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appliesToTaskTypes", "riskLabel", "qualityFloor"],
      "properties": {
        "appliesToTaskTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Canonical task types this family narrows. The ordering stage runs only when the request's task type is in this list.",
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "riskLabel": {
          "enum": ["low", "high"],
          "description": "Rollout risk band. Low-risk families are enabled first; high-risk families are last and only behind an approval policy."
        },
        "qualityFloor": {
          "type": "object",
          "additionalProperties": false,
          "description": "Minimum quality a candidate must clear before cost ranking. Expressed only against metadata the registry already carries. An empty object is a floor every candidate meets.",
          "properties": {
            "minimumSlotBand": {
              "$ref": "#/definitions/routingProfile"
            },
            "requiredCapabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/nonEmptyString"
              }
            },
            "minimumContextTokens": {
              "type": "integer",
              "minimum": 1
            },
            "minimumBenchmarkScores": {
              "type": "object",
              "minProperties": 1,
              "description": "Fail-closed: a model with no recorded score for a named benchmark fails the floor. Benchmark coverage is partial today, so authoring one of these will exclude every model that carries no score.",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "autoTaskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCapabilities",
        "requiredHarnessFeatures",
        "preferredSlots",
        "benchmarkWeights"
      ],
      "properties": {
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "requiredHarnessFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/nonEmptyString"
          }
        },
        "minimumContextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "preferredSlots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["economy", "balanced", "premium"],
          "properties": {
            "economy": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/nonEmptyString"
              }
            },
            "balanced": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/nonEmptyString"
              }
            },
            "premium": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/nonEmptyString"
              }
            }
          }
        },
        "benchmarkWeights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "autoSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelKey", "label", "description"],
      "properties": {
        "modelKey": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "label": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "description": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "shadow": {
          "$ref": "#/definitions/autoSlotShadow"
        },
        "canary": {
          "$ref": "#/definitions/autoSlotCanary"
        }
      }
    },
    "autoSlotShadow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelKey", "dailyRequestCap"],
      "properties": {
        "modelKey": {
          "$ref": "#/definitions/nonEmptyString",
          "description": "The candidate that receives a mirrored copy of this slot's request. Its result is recorded and discarded, never served."
        },
        "dailyRequestCap": {
          "type": "integer",
          "minimum": 1,
          "description": "Requests this candidate may be mirrored per day. Mirroring costs real money, so the ceiling is declared before any mirror happens."
        }
      }
    },
    "autoSlotCanary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelKey", "trafficFraction"],
      "properties": {
        "modelKey": {
          "$ref": "#/definitions/nonEmptyString",
          "description": "The candidate that serves a fraction of this slot's traffic. The breaker can pull it back to the promoted sibling."
        },
        "trafficFraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Share of this slot's requests the candidate serves, decided by a deterministic hash of the request id."
        }
      }
    }
  }
}
