{
  "name": "@agiworkforce/search",
  "version": "0.0.1",
  "description": "Registry-derived web-search harness availability. Reports what is wired; executes no search itself.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
