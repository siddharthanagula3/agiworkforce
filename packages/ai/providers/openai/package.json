{
  "name": "@agiworkforce/providers-openai",
  "version": "0.0.1",
  "description": "OpenAI API adapter and the OpenAI-compatible wire translation other adapters reuse.",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:live": "AGIWORKFORCE_LIVE_TEST=1 vitest run --passWithNoTests",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/provider-protocol": "workspace:*",
    "@agiworkforce/provider-runtime": "workspace:*",
    "@agiworkforce/types": "workspace:*",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
