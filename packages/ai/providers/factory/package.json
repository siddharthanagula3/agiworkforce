{
  "name": "@agiworkforce/providers-factory",
  "version": "0.0.1",
  "description": "Constructs provider adapters from caller-owned credentials; never holds keys itself.",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "dependencies": {
    "@agiworkforce/providers-anthropic": "workspace:*",
    "@agiworkforce/providers-deepseek": "workspace:*",
    "@agiworkforce/providers-google": "workspace:*",
    "@agiworkforce/providers-groq": "workspace:*",
    "@agiworkforce/providers-lmstudio": "workspace:*",
    "@agiworkforce/providers-minimax": "workspace:*",
    "@agiworkforce/providers-moonshot": "workspace:*",
    "@agiworkforce/providers-nvidia": "workspace:*",
    "@agiworkforce/providers-ollama": "workspace:*",
    "@agiworkforce/providers-openai": "workspace:*",
    "@agiworkforce/providers-openrouter": "workspace:*",
    "@agiworkforce/providers-perplexity": "workspace:*",
    "@agiworkforce/providers-qwen": "workspace:*",
    "@agiworkforce/providers-vercel-gateway": "workspace:*",
    "@agiworkforce/providers-workers-ai": "workspace:*",
    "@agiworkforce/providers-xai": "workspace:*",
    "@agiworkforce/providers-zhipu": "workspace:*",
    "@agiworkforce/types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
