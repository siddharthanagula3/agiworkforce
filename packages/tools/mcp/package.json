{
  "name": "@agiworkforce/mcp",
  "version": "0.0.1",
  "description": "MCP client transport and tool metadata for external servers.",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
