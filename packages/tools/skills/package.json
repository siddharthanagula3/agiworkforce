{
  "name": "@agiworkforce/skills",
  "version": "0.0.1",
  "description": "Parses, merges and integrity-checks untrusted skill metadata; backs skills-lock.json.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./validation": "./src/validation.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --cache --cache-strategy content --cache-location .cache/eslint --max-warnings=0"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
