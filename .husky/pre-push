#!/bin/sh

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR

if [ "${SKIP_PRE_PUSH:-}" = "1" ]; then
  echo "Skipping pre-push checks because SKIP_PRE_PUSH=1"
  exit 0
fi

if [ "${AGI_PREPUSH_ON_TREE:-}" = "1" ]; then
  pnpm check:llm-operability
  git diff --check
  git diff --cached --check
else
  bash scripts/prepush-clean-worktree.sh
fi
