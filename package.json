{
  "name": "agiworkforce",
  "version": "1.1.7",
  "private": true,
  "description": "AGI Workforce monorepo (Tauri + React + Rust)",
  "homepage": "https://agiworkforce.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddhartha/agiworkforce.git"
  },
  "license": "PROPRIETARY",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": "22",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "peerDependencyRules": {
      "ignoreMissing": []
    },
    "overrides": {
      "shell-quote": ">=1.8.4",
      "baseline-browser-mapping": "^2.9.11",
      "lodash-es": ">=4.18.1",
      "diff": "^5.2.2",
      "esbuild": ">=0.28.1",
      "jsdom": "20.0.3",
      "qs": ">=6.15.2",
      "minimatch@3": ">=3.1.4",
      "minimatch@9": ">=9.0.7",
      "tar": ">=7.5.11",
      "rollup": ">=4.59.0",
      "serialize-javascript": ">=7.0.5",
      "vite": ">=8.0.16",
      "undici": ">=8.5.0",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "@tootallnate/once": ">=3.0.1",
      "uuid": ">=14.0.0",
      "immer": "^11.1.4",
      "prismjs": ">=1.30.0",
      "dompurify": ">=3.4.0",
      "node-forge": ">=1.4.0",
      "path-to-regexp": ">=8.4.2",
      "@xmldom/xmldom": "^0.8.13",
      "postcss": ">=8.5.13",
      "brace-expansion": ">=5.0.6",
      "hono": ">=4.12.25",
      "ip-address": ">=10.1.1",
      "ws": ">=8.21.0",
      "fast-uri": ">=3.1.2",
      "form-data": ">=4.0.6",
      "tmp": ">=0.2.6",
      "zod": "^4.4.3",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "react-test-renderer": "19.2.6",
      "typescript": "5.9.3",
      "@types/node": "^22.19.15",
      "@wdio/native-utils": "2.5.0"
    },
    "patchedDependencies": {
      "expo@55.0.24": "patches/expo@55.0.24.patch"
    }
  },
  "scripts": {
    "prepare": "husky || true",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs,.mjs --cache --cache-strategy content --cache-location .cache/eslint/root --max-warnings=0 --ignore-pattern 'apps/extension/**'",
    "lint:extension": "eslint apps/extension --ext .ts,.tsx,.js,.cjs,.mjs --cache --cache-strategy content --cache-location .cache/eslint/extension --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "check:agent-context": "node scripts/check-agent-context.mjs",
    "check:repo-organization": "node scripts/check-repo-organization.mjs",
    "check:workspace-scripts": "node scripts/check-workspace-scripts.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:capability-boundaries": "node scripts/check-capability-boundaries.mjs",
    "check:module-reachability": "node scripts/check-module-reachability.mjs",
    "check:structure-conventions": "node scripts/check-structure-conventions.mjs",
    "check:mobile-hygiene": "node scripts/check-mobile-hygiene.mjs",
    "check:no-hex-mobile": "node scripts/check-no-hex-colors-mobile.mjs",
    "check:service-layer": "node scripts/check-service-layer.mjs",
    "check:lane-ownership": "node scripts/check-lane-ownership.mjs",
    "check:generated-artifacts": "node scripts/check-generated-artifacts.mjs",
    "check:report-retention": "node scripts/check-report-retention.mjs",
    "check:non-md-artifacts": "node scripts/check-non-md-artifacts.mjs",
    "check:neon-migrations": "node scripts/check-neon-migrations.mjs",
    "check:ci-guardrails": "node scripts/check-ci-guardrails.mjs",
    "check:codeowners": "node scripts/check-codeowners-contract.mjs",
    "check:readme-ownership": "node scripts/check-readme-ownership.mjs",
    "check:doc-status": "node scripts/check-doc-status.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:hook-fire-sites": "node apps/cli/scripts/check-hook-fire-sites.mjs",
    "check:hardcoded-arrays": "node scripts/check-hardcoded-fixture-arrays.mjs",
    "check:model-catalog": "node scripts/check-model-catalog-integrity.mjs",
    "check:availability-invariant": "node scripts/check-availability-invariant.mjs",
    "check:llm-failures": "node scripts/check-llm-failure-guardrails.mjs",
    "check:llm-failures:staged": "node scripts/check-llm-failure-guardrails.mjs --staged",
    "check:llm-failures:changed": "node scripts/check-llm-failure-guardrails.mjs --changed",
    "check:llm-failures:strict": "node scripts/check-llm-failure-guardrails.mjs --strict",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:trust-boundaries": "node scripts/check-trust-boundaries.mjs",
    "check:provider-contracts": "pnpm --filter @agiworkforce/types test -- provider-contract",
    "check:spec-artifacts": "node scripts/check-spec-artifacts.mjs",
    "sync:models": "node scripts/sync-models.mjs",
    "sync:models:check": "node scripts/sync-models.mjs --check",
    "sync:models:refresh": "node scripts/sync-models.mjs --refresh",
    "check:lock-drift": "node scripts/check-lock-build-drift.mjs",
    "check:llm-operability": "pnpm check:agent-context && pnpm check:repo-organization && pnpm check:workspace-scripts && pnpm check:boundaries && pnpm check:module-reachability && pnpm check:structure-conventions && pnpm check:mobile-hygiene && pnpm check:service-layer && pnpm check:lane-ownership && pnpm check:generated-artifacts && pnpm check:report-retention && pnpm check:non-md-artifacts && pnpm check:neon-migrations && pnpm check:ci-guardrails && pnpm check:codeowners && pnpm check:readme-ownership && pnpm check:doc-status && pnpm check:hooks && pnpm check:hook-fire-sites && pnpm check:model-catalog && pnpm check:availability-invariant && pnpm check:llm-failures",
    "audit:file-ledger": "node scripts/generate-surface-file-ledger.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @agiworkforce/desktop typecheck",
    "test": "pnpm -r test",
    "test:l1": "node scripts/run-priority-tier.mjs priority-level-1",
    "test:l2": "node scripts/run-priority-tier.mjs priority-level-2",
    "test:l1:l2": "pnpm test:l1 && pnpm test:l2",
    "test:l3": "node scripts/run-priority-tier.mjs priority-level-3",
    "test:l4": "node scripts/run-priority-tier.mjs priority-level-4",
    "test:l3:l4": "pnpm test:l3 && pnpm test:l4",
    "test:security": "node scripts/run-priority-tier.mjs security",
    "test:coverage": "vitest run --coverage --coverage.threshold.lines=75",
    "test:ci": "pnpm test:l1:l2 && pnpm test:coverage",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "clean:build": "pnpm -r exec rm -rf dist",
    "build": "pnpm build:all",
    "build:all": "pnpm -r --filter='!@agiworkforce/desktop' build",
    "build:desktop": "pnpm --filter @agiworkforce/desktop build",
    "build:docs": "pnpm docs:check",
    "dev:desktop": "pnpm --filter @agiworkforce/desktop dev",
    "docs:check": "pnpm check:doc-status && pnpm check:agent-context && pnpm check:non-md-artifacts",
    "typecheck:all": "pnpm -r --if-present typecheck",
    "demo:multi-provider": "tsx examples/multi-provider-chat.ts",
    "check:protocol-types": "node scripts/generate-protocol-types.mjs && git diff --exit-code -- packages/types/src/generated"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "baseline-browser-mapping": "^2.10.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix --ignore-pattern 'apps/extension/**'",
      "prettier --write"
    ],
    "**/*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "simple-icons": "^16.18.1"
  }
}
