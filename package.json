{
  "name": "agiworkforce",
  "private": true,
  "//version": "Intentionally no version field. This is a private workspace manifest, not a shippable product. Each app owns its own version and the release workflows read those directly (e.g. release-desktop.yml reads apps/desktop/package.json). A root version drifted to 1.1.7 while desktop/mobile/extension shipped 1.2.0, which read as a product version and was wrong everywhere. Founder decision 2026-08-04.",
  "description": "AGI Workforce monorepo (Tauri + React + Rust)",
  "homepage": "https://agiworkforce.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/siddhartha/agiworkforce.git"
  },
  "license": "PROPRIETARY",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": "24",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "peerDependencyRules": {
      "ignoreMissing": []
    },
    "auditConfig": {
      "_comment": "Suppressions of last resort: only advisories with NO published fix belong here, and each must be re-checked whenever the audit runs green for another reason. Everything fixable goes in overrides above instead. GHSA-w3rx-r6r6-pgpr (ICNS parser) and GHSA-5p2g-fcmc-qvqq (JXL/HEIF parsers) are image-size denial-of-service advisories covering <=2.0.2, which is the latest published version (2025-04-02) — there is nothing to upgrade to. image-size is reached only through metro, React Native's build-time bundler, pulled in by react-i18next in packages/ui/i18n; it is not in any shipped runtime path, so exposure is a bundler hang on a malicious image at build time. Remove both entries as soon as image-size publishes a patched release.",
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    },
    "overrides": {
      "shell-quote": ">=1.9.0 <2",
      "baseline-browser-mapping": "^2.9.11",
      "lodash-es": ">=4.18.1",
      "diff": "^5.2.2",
      "esbuild": ">=0.28.1",
      "jsdom": "20.0.3",
      "qs": ">=6.15.2",
      "minimatch@3": ">=3.1.4",
      "minimatch@9": ">=9.0.7",
      "tar": ">=7.5.19",
      "rollup": ">=4.59.0",
      "serialize-javascript": ">=7.0.5",
      "vite": ">=8.0.16",
      "undici": ">=8.9.0 <9",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "@tootallnate/once": ">=3.0.1",
      "uuid": ">=14.0.0",
      "immer": "^11.1.4",
      "prismjs": ">=1.30.0",
      "dompurify": ">=3.4.0",
      "node-forge": ">=1.4.0",
      "path-to-regexp": ">=8.4.2",
      "@xmldom/xmldom": "^0.8.13",
      "postcss": ">=8.5.18 <9",
      "brace-expansion": ">=5.0.9 <6",
      "hono": ">=4.12.25",
      "ip-address": ">=10.3.1 <11",
      "ws": ">=8.21.0",
      "fast-uri": ">=3.1.5 <4",
      "fast-xml-parser": ">=5.10.1 <6",
      "js-yaml@3": ">=3.15.1 <4",
      "js-yaml@4": ">=4.3.1 <5",
      "nanoid@3": ">=3.3.17 <4",
      "nanoid@5": ">=5.1.16 <6",
      "linkify-it@5": ">=5.0.2 <6",
      "form-data": ">=4.0.6",
      "tmp": ">=0.2.6",
      "zod": "^4.4.3",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "react-test-renderer": "19.2.6",
      "typescript": "5.9.3",
      "@types/node": "^24.13.3",
      "@wdio/native-utils": "2.5.0"
    },
    "patchedDependencies": {
      "expo@55.0.28": "patches/expo@55.0.28.patch"
    }
  },
  "scripts": {
    "prepare": "husky || true",
    "lint": "turbo run lint --filter='!@agiworkforce/extension'",
    "lint:extension": "turbo run lint --filter=@agiworkforce/extension",
    "lint:fix": "turbo run lint --filter='!@agiworkforce/extension' -- --fix",
    "check:agent-context": "node scripts/check-agent-context.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:connector-logos": "node scripts/check-connector-logos.mjs",
    "check:audit-inventory": "node scripts/check-audit-inventory.mjs",
    "check:capability-gaps": "node scripts/check-capability-gaps.mjs",
    "audit:import-ui-gaps": "node scripts/import-ui-gaps.mjs",
    "generate:ui-gaps": "node scripts/import-ui-gaps.mjs --render",
    "check:ui-gaps": "node scripts/check-ui-gaps.mjs",
    "check:ui-gaps:monotonic": "node scripts/check-ui-gaps.mjs --monotonic",
    "check:executable-docs": "node scripts/check-executable-docs.mjs",
    "generate:agent-context-indexes": "node scripts/generate-agent-context-indexes.mjs",
    "check:agent-context-indexes": "node scripts/check-agent-context-indexes.mjs",
    "check:repo-organization": "node scripts/check-repo-organization.mjs",
    "check:workspace-scripts": "node scripts/check-workspace-scripts.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:cloud-contract-ownership": "node scripts/check-cloud-contract-ownership.mjs",
    "check:artifact-sync-ownership": "node scripts/check-artifact-sync-ownership.mjs",
    "check:service-domain-ownership": "node scripts/check-service-domain-ownership.mjs",
    "check:capability-boundaries": "node scripts/check-capability-boundaries.mjs",
    "check:module-reachability": "node scripts/check-module-reachability.mjs",
    "check:surface-reachability": "node --test scripts/module-graph.test.mjs scripts/check-surface-reachability.test.mjs && node scripts/check-surface-reachability.mjs",
    "check:surface-invariants": "node --test scripts/check-surface-invariants.test.mjs && node scripts/check-surface-invariants.mjs",
    "check:structure-conventions": "node scripts/check-structure-conventions.mjs",
    "check:mobile-hygiene": "node scripts/check-mobile-hygiene.mjs",
    "env:doctor": "node scripts/env-doctor.mjs",
    "check:env-contract": "node scripts/env-doctor.mjs --check-examples",
    "check:no-hex-mobile": "node scripts/check-no-hex-colors-mobile.mjs",
    "check:service-layer": "node scripts/check-service-layer.mjs",
    "check:lane-ownership": "node scripts/check-lane-ownership.mjs",
    "check:generated-artifacts": "node scripts/check-generated-artifacts.mjs",
    "check:report-retention": "node scripts/check-report-retention.mjs",
    "check:non-md-artifacts": "node scripts/check-non-md-artifacts.mjs",
    "check:neon-migrations": "node scripts/check-neon-migrations.mjs && node --test scripts/neon-migrate.test.mjs",
    "db:migrate": "node scripts/neon-migrate.mjs",
    "db:rls-probe": "node apps/web/scripts/rls-probe.mjs",
    "test:db-migrate": "node --test scripts/neon-migrate.test.mjs",
    "check:ci-guardrails": "node scripts/check-ci-guardrails.mjs && node --test scripts/production-deploy-scope.test.mjs scripts/verify-gateway-deployment.test.mjs",
    "check:codeowners": "node scripts/check-codeowners-contract.mjs",
    "check:readme-ownership": "node scripts/check-readme-ownership.mjs",
    "check:doc-status": "node scripts/check-doc-status.mjs",
    "check:reference-integrity": "node --test scripts/check-reference-integrity.test.mjs && node scripts/check-reference-integrity.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:hook-fire-sites": "node apps/cli/scripts/check-hook-fire-sites.mjs",
    "check:hardcoded-arrays": "node scripts/check-hardcoded-fixture-arrays.mjs",
    "check:model-catalog": "node scripts/check-model-catalog-integrity.mjs",
    "check:availability-invariant": "node scripts/check-availability-invariant.mjs",
    "check:llm-failures": "node scripts/check-llm-failure-guardrails.mjs",
    "check:llm-failures:staged": "node scripts/check-llm-failure-guardrails.mjs --staged",
    "check:llm-failures:changed": "node scripts/check-llm-failure-guardrails.mjs --changed",
    "check:llm-failures:strict": "node scripts/check-llm-failure-guardrails.mjs --strict",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:trust-boundaries": "node scripts/check-trust-boundaries.mjs",
    "check:provider-contracts": "pnpm --filter @agiworkforce/types test -- provider-contract",
    "check:spec-artifacts": "node scripts/check-spec-artifacts.mjs",
    "sync:models": "pnpm --filter @agiworkforce/model-registry generate",
    "sync:models:check": "pnpm --filter @agiworkforce/model-registry check",
    "sync:models:refresh": "pnpm --filter @agiworkforce/model-registry refresh",
    "check:lock-drift": "node scripts/check-lock-build-drift.mjs",
    "check:llm-operability": "pnpm check:agent-context && pnpm check:audit-inventory && pnpm check:capability-gaps && pnpm check:ui-gaps && pnpm check:executable-docs && pnpm check:agent-context-indexes && pnpm check:repo-organization && pnpm check:workspace-scripts && pnpm check:boundaries && pnpm check:cloud-contract-ownership && pnpm check:artifact-sync-ownership && pnpm check:service-domain-ownership && pnpm check:module-reachability && pnpm check:surface-reachability && pnpm check:surface-invariants && pnpm check:structure-conventions && pnpm check:mobile-hygiene && pnpm check:env-contract && pnpm check:service-layer && pnpm check:lane-ownership && pnpm check:generated-artifacts && pnpm sync:models:check && pnpm check:report-retention && pnpm check:non-md-artifacts && pnpm check:neon-migrations && pnpm check:ci-guardrails && pnpm check:workflow-cargo-features && pnpm check:codeowners && pnpm check:readme-ownership && pnpm check:doc-status && pnpm check:hooks && pnpm check:hook-fire-sites && pnpm check:model-catalog && pnpm check:marketing-models && pnpm check:availability-invariant && pnpm check:db-isolation && pnpm check:css-tokens && pnpm check:llm-failures",
    "audit:file-ledger": "node scripts/generate-surface-file-ledger.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck --filter=@agiworkforce/desktop",
    "test": "turbo run test --concurrency=2",
    "test:affected": "turbo run test --affected --concurrency=2",
    "test:l1": "node scripts/run-priority-tier.mjs priority-level-1",
    "test:l2": "node scripts/run-priority-tier.mjs priority-level-2",
    "test:l1:l2": "pnpm test:l1 && pnpm test:l2",
    "test:l3": "node scripts/run-priority-tier.mjs priority-level-3",
    "test:l4": "node scripts/run-priority-tier.mjs priority-level-4",
    "test:l3:l4": "pnpm test:l3 && pnpm test:l4",
    "test:security": "node scripts/run-priority-tier.mjs security",
    "test:coverage": "vitest run --coverage --coverage.threshold.lines=75",
    "test:ci": "pnpm test:l1:l2 && pnpm test:coverage",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "clean:build": "pnpm -r exec rm -rf dist",
    "build": "turbo run build --filter='!@agiworkforce/desktop'",
    "build:all": "turbo run build --filter='!@agiworkforce/desktop'",
    "build:desktop": "turbo run build --filter=@agiworkforce/desktop",
    "build:docs": "pnpm docs:check",
    "dev:desktop": "turbo run dev --filter=@agiworkforce/desktop",
    "docs:check": "pnpm check:doc-status && pnpm check:agent-context && pnpm check:non-md-artifacts && pnpm check:reference-integrity",
    "typecheck:all": "turbo run typecheck",
    "demo:multi-provider": "tsx examples/multi-provider-chat.ts",
    "generate:protocol-types": "node scripts/generate-protocol-types.mjs --write",
    "check:protocol-types": "node scripts/generate-protocol-types.mjs --check",
    "check:db-isolation": "node scripts/check-db-isolation.mjs",
    "check:css-tokens": "node scripts/check-css-tokens.mjs",
    "check:knip": "knip",
    "check:knip:production": "knip --production",
    "check:marketing-models": "node scripts/check-marketing-models.mjs",
    "check:workflow-cargo-features": "node scripts/check-workflow-cargo-features.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "baseline-browser-mapping": "^2.10.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^16.4.0",
    "pg": "^8.22.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "turbo": "2.10.5",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix --ignore-pattern 'apps/extension/**'",
      "prettier --write"
    ],
    "**/*.{json,md,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "simple-icons": "^16.18.1"
  }
}
