    "peerDependencyRules": {
      "ignoreMissing": []
    },
    "auditConfig": {
      "_comment": "Suppressions of last resort: only advisories with NO published fix belong here, and each must be re-checked whenever the audit runs green for another reason. Everything fixable goes in overrides above instead. GHSA-w3rx-r6r6-pgpr (ICNS parser) and GHSA-5p2g-fcmc-qvqq (JXL/HEIF parsers) are image-size denial-of-service advisories covering <=2.0.2, which is the latest published version (2025-04-02), there is nothing to upgrade to. image-size is reached only through metro, React Native's build-time bundler, pulled in by react-i18next in packages/ui/i18n; it is not in any shipped runtime path, so exposure is a bundler hang on a malicious image at build time. Remove both entries as soon as image-size publishes a patched release.",
      "_comment2": "GHSA-jmr9-qjv8-65gv (extract-zip symlink path traversal) covers <=2.0.1, and 2.0.1 IS the latest published version, `npm view extract-zip version` returns it, and the advisory's own patched range is <0.0.0, i.e. no fix exists to upgrade to. It is reached only through apps/desktop's @wdio/* devDependencies (the WebdriverIO e2e runner) via @puppeteer/browsers, which downloads a browser archive from Google's own CDN at test time. It is not in any shipped runtime path and no attacker-supplied zip reaches it. Remove this entry as soon as extract-zip publishes a patched release.",
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-jmr9-qjv8-65gv"
      ]
    },
