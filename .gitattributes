* text=auto eol=lf

# Ensure images and archives are treated as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z  binary
*.gz  binary
*.jar binary


# A unified diff marks a blank context line with a single space, and the
# security gate pins these files byte for byte, so the whitespace check does
# not apply to them.
patches/*.patch -whitespace
