# ==========================================
# AGI Workforce - Complete .gitignore
# ==========================================

# --- Node.js / NPM / PNPM ---
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
*.tsbuildinfo
.npm
.eslintcache
.node_repl_history
*.tgz
*.backup

# --- Logs ---
logs/
*.log
report.*.json

# --- Internal/local artifacts (root-level only) ---
/artifacts/

# --- Runtime data ---
pids/
*.pid
*.seed
*.pid.lock

# --- Coverage directories ---
coverage/
*.lcov
.nyc_output/
lib-cov/

# --- Build artifacts ---
dist/
dist-ssr/
# electron-builder output for the desktop cloud shell
apps/desktop/release/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/
*.local
*.tsbuildinfo

# --- Distribution/Downloads ---
**/public/downloads/

# --- Vite specific ---
vite.config.*.timestamp-*

# --- Tauri specific ---
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/native_messaging_host-*
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/WixTools/
apps/desktop/src-tauri/tauri-info.json

# --- Rust / Cargo ---
**/target/
**/*.rs.bk
**/*.rlib
*.rlib
Cargo.lock
# Allow Cargo.lock for applications and workspace root
!apps/**/Cargo.lock
!/Cargo.lock

# --- Database files ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Testing ---
.vitest/
.playwright-mcp/
playwright-report/
test-results/
playwright/.cache/

# --- OS specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE / Editor ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.code-workspace

# --- Environment variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.*.local
# Timestamped backups written before an env rewrite (.env.local.bak-<stamp>).
# None of the patterns above match a suffix AFTER `.local`, so these were
# committable — a backup of a secret file is still a secret file.
.env*.bak*
!.env.example
!.env.local.example

# --- Temporary files ---
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
.temp/
.tmp/
/tmp/

# Generated review and export deliverables are preserved locally but are not
# source inputs to the monorepo build graph.
/outputs/

# --- Application data ---
apps/desktop/src-tauri/agiworkforce.db
apps/desktop/src-tauri/test.db
agiworkforce.db*

# --- Generated files ---
package-lock.json
!apps/cli/npm/package-lock.json
yarn.lock

# --- Debug files ---
/debug/
*.pdb

# --- Certificates and keys ---
*.pem
*.key
*.crt
*.p12
*.pfx
# Test fixtures — these are self-signed certs used only by unit
# tests for the custom-CA loader. Safe to commit; do not contain
# any production secrets.
!crates/agiworkforce-client/tests/fixtures/*.pem
!crates/agiworkforce-client/tests/fixtures/*.key

# --- Tauri update signing keys (never commit private keys) ---
apps/desktop/src-tauri/tauri-signing
apps/desktop/src-tauri/tauri-signing.pub

# --- MCP Configuration (contains sensitive credentials) ---
.mcp.json

# --- Application cache (root-level only) ---
.cache/
/cache/

# --- Playwright browsers ---
ms-playwright/

# --- Turbo ---
.turbo/

# --- Vercel ---
.vercel

# --- Sentry ---
.sentryclirc
.env*.local

# --- Neon local secrets ---
.neon
.neon.env*
.neon.local*

# --- Build outputs ---
*.dmg
*.exe
*.AppImage
*.deb
*.rpm
*.msi

# --- Agent/AI temp files ---
.agent/
.claude/*
# but track project-scoped subagent definitions + commands + rules so the
# whole team / AI sessions get the same orchestration baseline
!.claude/README.md
!.claude/agents/
!.claude/commands/
!.claude/rules/

# --- Business / personal data ---
leads/

# --- Supabase temp files ---
**/.temp/
.worktrees/
.code-review-graph/
.firecrawl/
dist-web
# Build artifacts (Vite SPA output)
apps/web/public/chat

# Claude Code local files
CLAUDE.local.md
.claude/settings.local.json
.claude/*.local.*
Cross.toml

# Transient gate battery logs
reports/audit/gate-baseline/

# Workspace-generated audit artifacts (authoritative findings in AUDIT_FINDINGS.md)
AUDIT_PARTS/
AUDIT_BATCHES/
AUDIT_MANIFEST.txt

# --- Generated QA artifacts / local scratch (not for main) ---
.agiworkforce/
apps/web/app/qa-artifacts/
reports/generated/
tasks/release-hardening/
/qa-inchat.png
/qa-inchat-split.png

# Recycle-bin archive (files staged for founder review before deletion; recoverable)
_archive/

# Founder demo-prep working notes (root-level scratch, not repo truth)
/investor_demo_prep.md

# Root-level debug/repro screenshots. The repo root has a closed file
# allowlist (scripts/check-repo-organization.mjs), so no screenshot belongs
# here; these accumulate from local UI debugging. Generalizes the earlier
# one-off /qa-inchat*.png entries above.
/*.png

# Python bytecode from the skill-vetting test run. Untracked either way, but
# the model-id guard walks the working tree and cannot decode a .pyc.
__pycache__/
*.pyc

# Security-scan output directories (claude-security plugin). Each run drops a
# CLAUDE-SECURITY-<timestamp>/ at the root holding findings, SARIF, and an
# UNVERIFIED-CANDIDATES list. They are local scan artifacts, and the contents
# describe unpatched weaknesses, so they must never reach a commit. Ignoring
# them also keeps them out of the closed root allowlist in
# scripts/check-repo-organization.mjs, which skips gitignored entries.
/CLAUDE-SECURITY-*/
