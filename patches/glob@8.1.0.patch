     return

   this._processing++
+  if (this._hiddenPatterns && this._hiddenPatterns[index]) return process.nextTick(cb)
   if (this.paused) {
     this._processQueue.push([pattern, index, inGlobStar, cb])
     return
@@ -382,7 +383,7 @@ Glob.prototype._processReaddir2 = function (prefix, read, abs, remain, index, in
   // dot is set.  Stuff like @(.foo|.bar) isn't allowed.
   var pn = remain[0]
   var negate = !!this.minimatch.negate
-  var rawGlob = pn._glob
+  var rawGlob = pn._glob || pn.pattern
   var dotOk = this.dot || rawGlob.charAt(0) === '.'

   var matchedEntries = []
@@ -391,9 +392,9 @@ Glob.prototype._processReaddir2 = function (prefix, read, abs, remain, index, in
     if (e.charAt(0) !== '.' || dotOk) {
       var m
       if (negate && !prefix) {
-        m = !e.match(pn)
+        m = !pn.test(e)
       } else {
-        m = e.match(pn)
+        m = pn.test(e)
       }
       if (m)
         matchedEntries.push(e)
