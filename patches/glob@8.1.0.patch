diff --git a/common.js b/common.js
index 61a4452f097dcd28e7c2ed6ea1a45d643b8b1641..32da082ee20308d3f3ddd25729130ca3b9e1cc86 100644
--- a/common.js
+++ b/common.js
@@ -120,6 +120,18 @@ function setopts (self, pattern, options) {
   options.nocomment = true

   self.minimatch = new Minimatch(pattern, options)
+
+  if (!self.dot) {
+    var globParts = self.minimatch.globParts
+    self._hiddenPatterns = self.minimatch.set.map(function (parts, index) {
+      return parts.some(function (part, partIndex) {
+        var raw = globParts[index][partIndex]
+        return typeof part === 'string' && part.charAt(0) === '.' &&
+          raw.charAt(0) !== '.' && raw.slice(0, 2) !== '\\.'
+      })
+    })
+  }
+
   self.options = self.minimatch.options
 }

