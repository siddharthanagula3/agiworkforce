{
  "suite": "turn_signals",
  "labeller": "single author, one pass, not independently reviewed",
  "question": "Task family from the router's own vocabulary, plus needs_current_info, needs_external_tools, needs_code, and a complexity level.",
  "fieldDefinitions": {
    "family": "The dominant task the turn asks for, from RoutingTaskType restricted to the text-decidable members.",
    "needs_current_info": "A correct answer depends on information that may have changed since training, so the turn needs live retrieval.",
    "needs_external_tools": "Answering requires an action outside the chat: a web search or fetch, an image render, a file export, a code run, or a connector call. A superset of needs_code.",
    "needs_code": "A correct answer requires code to be executed, not merely written or shown.",
    "complexity": "trivial (a greeting or one direct fact), simple (one familiar task, few dependencies), medium (several dependent steps or analysis of evidence), difficult (extensive investigation or interacting constraints), frontier (no settled method exists)."
  },
  "ambiguousNote": "A case may be ambiguous in one field and definite in the others. `ambiguous` lists only the undecidable fields with both defensible values; every other field on that case is scored normally.",
