        {
          "sourceClass": "past_chat",
          "locator": "conversation/c-9#m-2",
          "authoredBy": "user",
          "ownerUserId": "u-1",
          "text": "The interface polish checklist I wrote for the release."
        },
        {
          "sourceClass": "past_chat",
          "locator": "conversation/c-77#m-4",
          "authoredBy": "user",
          "ownerUserId": "u-2",
          "text": "Northwind severance terms we agreed on Friday."
        }
      ],
      "expect": {
        "includes": ["past_chat:conversation/c-9#m-2"],
