{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "corepack enable && corepack prepare pnpm@9.15.3 --activate && bash apps/web/scripts/build-with-chat.sh",
  "devCommand": "pnpm --filter @agiworkforce/web dev",
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.3 --activate && pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "ignoreCommand": "bash vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/reset-credits",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/purge-temporary-chats",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reconcile-credits",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/run-schedules",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reclaim-sandboxes",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/cron/purge-deleted-media",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/purge-deleted-organizations",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/cron/expire-support-handoffs",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/health-probe",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/expire-organization-invitations",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/purge-security-audit-logs",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/enforce-billing-retention",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/enforce-workspace-retention",
      "schedule": "20 4 * * *"
    },
    {
      "path": "/api/cron/drain-audit-streams",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/page-security-anomalies",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/refresh-connector-directory",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/report-enterprise-usage",
      "schedule": "10 5 * * *"
    },
    {
      "path": "/api/cron/enforce-billing-collection",
      "schedule": "20 5 * * *"
    }
  ]
}
